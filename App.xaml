<Application x:Class="KyoneMusic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KyoneMusic.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Fontes e Recursos Globais DEPOIS dos MergedDictionaries -->
            <!-- Zen Kaku Gothic New -->
            <FontFamily x:Key="FonteZenNew">pack://application:,,,/Resources/Fonts/#Zen Kaku Gothic New</FontFamily>
            <FontFamily x:Key="FonteZenNewLight">pack://application:,,,/Resources/Fonts/#Zen Kaku Gothic New Light</FontFamily>
            <FontFamily x:Key="FonteZenNewMedium">pack://application:,,,/Resources/Fonts/#Zen Kaku Gothic New Medium</FontFamily>
            <FontFamily x:Key="FonteZenNewBlack">pack://application:,,,/Resources/Fonts/#Zen Kaku Gothic New Black</FontFamily>

            <FontFamily x:Key="FonteUI">/Resources/Fonts/#Figtree, /Resources/Fonts/#Zen Kaku Gothic New, Segoe UI</FontFamily>
            <FontFamily x:Key="FonteUILight">/Resources/Fonts/#Figtree Light, /Resources/Fonts/#Zen Kaku Gothic New Light, Segoe UI</FontFamily>
            <FontFamily x:Key="FonteUIMedium">/Resources/Fonts/#Figtree Medium, /Resources/Fonts/#Zen Kaku Gothic New Medium, Segoe UI</FontFamily>
            <FontFamily x:Key="FonteUISemiBold">/Resources/Fonts/#Figtree SemiBold, /Resources/Fonts/#Zen Kaku Gothic New, Segoe UI</FontFamily>
            <FontFamily x:Key="FonteUIBlack">/Resources/Fonts/#Figtree Black, /Resources/Fonts/#Zen Kaku Gothic New Black, Segoe UI</FontFamily>

            <converters:MusicaAtualConverter x:Key="MusicaAtualConverter" />
            <converters:BytesParaImagemConverter x:Key="BytesParaImagemConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:IndiceParaNumeroConverter x:Key="IndiceParaNumeroConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StringVazioParaVisibilidadeConverter x:Key="StringVazioParaVisibilidade" />
            <converters:LinhaAtualConverter x:Key="LinhaAtualConverter" />
            <converters:ProgressoParaLarguraConverter x:Key="ProgressoParaLarguraConverter" />
            <converters:MusicaEPlaylistConverter x:Key="MusicaEPlaylistConverter" />
            <converters:StringParaImagemConverter x:Key="StringParaImagemConverter" />
            <converters:StringToUriConverter x:Key="StringToUriConverter" />
            <converters:GanhoParaAlturaConverter x:Key="GanhoParaAlturaConverter" />
            <converters:BytesParaGradienteConverter x:Key="BytesParaGradienteConverter" />

            <ResourceDictionary.MergedDictionaries>
                <!-- HandyControl Resources -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <!-- Tema Local -->
                <ResourceDictionary Source="/Resources/Themes/Colors_Asa.xaml" />

                <!--Styles-->
                <ResourceDictionary Source="/Resources/Components/HoverListbox.xaml" />
                <ResourceDictionary Source="/Resources/Components/PrettyScrollBar.xaml" />
                <ResourceDictionary Source="/Resources/Components/PrettySlider.xaml" />
                <ResourceDictionary Source="/Resources/Components/PrettySliderEqualizer.xaml" />
                <ResourceDictionary Source="/Resources/Components/Styles.xaml" />
                <ResourceDictionary Source="/Resources/Components/ContextMenus.xaml" />

                <!-- Idioma -->
                <ResourceDictionary Source="/Resources/Languages/Strings.pt.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>