<Window x:Class="KyoneMusic.Views.EditarPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KyoneMusic.Views"
        mc:Ignorable="d"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:viewmodels="clr-namespace:KyoneMusic.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:EditarPlaylistViewModel}"
        Title=""
        Width="340" Height="380"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="NoResize">
    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxExtend}">
                <Setter Property="Width" Value="auto" />
                <Setter Property="Height" Value="auto" />
                <Setter Property="Margin" Value="0,16" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentAltBrush}" />
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource Str_Renomear}" Margin="24,20,0,10" Style="{StaticResource TitleMain}"  FontSize="24"/>
        <StackPanel Grid.Row="1" Margin="24,0" VerticalAlignment="Bottom">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="160" Height="160" CornerRadius="16"
                    Background="{DynamicResource SurfaceRaisedBrush}" Padding="24">
                <Viewbox Width="60">
                    <iconPacks:PackIconPhosphorIcons Kind="PlaylistBold" Foreground="{DynamicResource TextMutedBrush}"/>
                </Viewbox>
            </Border>
            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
            <Button Content="{DynamicResource Str_Cancelar}" Click="Cancelar_Click" Style="{StaticResource ActionButton}" />
            <Button Content="{DynamicResource Str_Concluir}"
                    Command="{Binding SalvarCommand}"
                    Style="{StaticResource ActionConfirmButton}" Margin="8,0" />
        </StackPanel>
    </Grid>
</Window>