<UserControl x:Class="KyoneMusic.Views.ShellPages.PlaylistsPages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:KyoneMusic.Converters"
             xmlns:local="clr-namespace:KyoneMusic.Views.ShellPages"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:shellpages="clr-namespace:KyoneMusic.ViewModels.ShellPages"
             d:DataContext="{d:DesignInstance Type=shellpages:PlaylistsPageViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid>
        <Grid Style="{StaticResource TransicaoEntrada}">
            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== BARRA ÚNICA NO TOPO ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Str_Playlists}"
                           Style="{StaticResource TitleMain}" />

                <Button Command="{Binding MostrarModalCommand}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="25,0"
                        hc:BorderElement.CornerRadius="16"
                        HorizontalAlignment="Right"
                        Style="{StaticResource ActionButton}"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center" Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="ListPlus" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Add_Play}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== GRADE DE PLAYLISTS ===== -->
            <ItemsControl Grid.Row="1" Margin="10"  ItemsSource="{Binding Playlists}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False"
                                      Template="{StaticResource MeuScrollViewer}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="332,132" StretchItems="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border  Height="120" Margin="6"
                                CornerRadius="16"
                                ClipToBounds="True"
                                Style="{StaticResource BorderClip}"
                                BorderThickness="0"
                                MouseLeftButtonUp="Playlist_MouseLeftButtonUp"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Cursor="Hand">
                            <Border.ContextMenu>
                                <ContextMenu Visibility="{Binding MenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <MenuItem Command="{Binding PlacementTarget.Tag.EditarPlaylistCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Playlist}">
                                        <MenuItem.Header>
                                            <Grid>
                                                <TextBlock Text="{DynamicResource Str_Renomear}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <iconPacks:PackIconPhosphorIcons Kind="Tag" HorizontalAlignment="Right"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Command="{Binding PlacementTarget.Tag.PedirExclusaoCommand,
                                              RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Playlist}">
                                        <MenuItem.Header>
                                            <Grid>
                                                <TextBlock Text="{DynamicResource Str_Eliminar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <iconPacks:PackIconPhosphorIcons Kind="TrashSimpleFill" HorizontalAlignment="Right"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource TextError}" Width="14" />
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid Background="{DynamicResource SurfaceOverlayBrush}" Opacity="1" />
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Capa quadrada, topo -->
                                    <Grid Grid.Column="0">
                                        <Border CornerRadius="8" Width="100"
                                                Height="100"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                Style="{StaticResource BorderClip}"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=200}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                                <iconPacks:PackIconPhosphorIcons Kind="PlaylistBold"
                                                                                 Width="32" Height="32"
                                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="16,0,0,0">

                                        <!-- Nome -->
                                        <StackPanel>
                                            <TextBlock FontSize="16" FontFamily="{DynamicResource FonteUISemiBold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,8,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Playlist.Name}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Playlist.Name}" Value="Favoritos">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Playlist.NumMusicas}"
                                                       FontSize="12"
                                                       FontFamily="{DynamicResource FonteUIMedium}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />

                                            <!-- Duas músicas de exemplo -->
                                            <StackPanel Margin="0,5">
                                                <ItemsControl ItemsSource="{Binding ListaMusicas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                                <iconPacks:PackIconPhosphorIcons Kind="MusicNoteFill" Foreground="{DynamicResource TextMutedBrush}" Width="12" Height="12" />
                                                                <TextBlock Margin="8,0" Text="{Binding}" MaxWidth="140"
                                                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <Button Width="30" Height="30" Margin="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="12"
                                        Content="{iconPacks:PhosphorIcons Kind=DotsThreeVerticalBold, Width=16, Height=16}"
                                        Style="{StaticResource IconButtonSmall}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding MenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="AbrirMenuPlaylist_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>