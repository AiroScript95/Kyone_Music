<UserControl x:Class="KyoneMusic.Views.ShellPages.ConfiguracoesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converter="clr-namespace:KyoneMusic.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:KyoneMusic.Views.ShellPages"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:vm="clr-namespace:KyoneMusic.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid Style="{StaticResource TransicaoEntrada}">
            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource Str_Configuracoes}"
                       Style="{StaticResource TitleMain}" />

            <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="8,0,8,16" Template="{StaticResource MeuScrollViewer}"
                          VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- ===== SECÇÃO: APARÊNCIA ===== -->
                    <Border Style="{StaticResource ConfigCard}" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Aparencia}" Style="{StaticResource ConfigSectionTitle}" />
                            <!-- Tema -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Str_Idioma}" Margin="8,0" FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding IdiomasDisponiveis}"
                                          HorizontalAlignment="Right"
                                          SelectedValue="{Binding IdiomaSelecionado, Mode=TwoWay}"
                                          SelectedValuePath="Codigo" ItemContainerStyle="{StaticResource ComboxItem}">

                                    <!-- Visual dos itens dentro do menu suspenso -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Padding="0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconPhosphorIcons Kind="Globe" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" Margin="10,0,0,0"  HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Tema}" Margin="8,0" FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Grid.Column="1" Command="{Binding IrParaTemaCommand}" Style="{StaticResource ActionButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Kind="Palette"
                                                                         Width="16" Height="16"
                                                                         Margin="0,0,6,0"
                                                                         VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_Personalizar}" VerticalAlignment="Center"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== SECÇÃO: BIBLIOTECA ===== -->
                    <Border Style="{StaticResource ConfigCard}" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Biblioteca}" Style="{StaticResource ConfigSectionTitle}" />

                            <!-- Pasta padrão -->
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                        Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,12,0">
                                    <iconPacks:PackIconPhosphorIcons Kind="LockSimpleFill" Width="18" Height="18"
                                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_Pasta_Padrao}" FontSize="14" FontFamily="{DynamicResource FonteUISemiBold}"
                                               Margin="0,0,0,4" Style="{StaticResource ConfigSectionTitle}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Text="{Binding PastaPadrao}" FontSize="14"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!-- Lista de pastas adicionais -->
                            <ItemsControl ItemsSource="{Binding PastasAdicionais}" Margin="0,4,0,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="100*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                                    Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,12,0">
                                                <iconPacks:PackIconPhosphorIcons Kind="FolderBold" Width="18" Height="18"
                                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center"
                                                       FontWeight="Medium"
                                                       FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource RemoverPastaButton}" Width="36" Height="36"
                                                    Command="{Binding DataContext.RemoverPastaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{DynamicResource Str_Eliminar}">
                                                <iconPacks:PackIconPhosphorIcons Kind="TrashSimpleFill" Width="18" Height="18" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Command="{Binding AdicionarPastaCommand}"
                                    Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_Add_Pasta}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ===== SECÇÃO: Dispositiovos de Saida ===== -->
                    <Border Style="{StaticResource ConfigCard}" Margin="0,4">
                        <Grid>
                            <TextBlock Text="Dispositivos de Saida" Style="{StaticResource ConfigSectionTitle}" />
                            <ComboBox ItemsSource="{Binding DispositivoAudios}" HorizontalAlignment="Right"
                                      SelectedItem="{Binding DispositivoSelecionado, Mode=TwoWay}"
                                      ItemContainerStyle="{StaticResource ComboxItem}">
                                <!-- Visual dos itens (lista e campo principal) -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconPhosphorIcons Kind="SpeakerHigh" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <!-- ===== SECÇÃO: Timer de Sono ===== -->
                    <Border Style="{StaticResource ConfigCard}" Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_TemporizadorSono}"
                                           Style="{StaticResource ConfigSectionTitle}" />
                                <TextBlock Text="Pausar a reprodução após o tempo escolhido"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Border Margin="8,0"
                                    Padding="16,10" HorizontalAlignment="Right"
                                    CornerRadius="8" VerticalAlignment="Center"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    Visibility="{Binding Player.TimerSonoAtivo,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconPhosphorIcons Kind="TimerBold" VerticalAlignment="Center"
                                                                     Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock  Text="{Binding Player.TempoSonoRestante}"
                                               VerticalAlignment="Center"
                                               FontSize="14" Margin="6,0,0,0"
                                               FontFamily="{DynamicResource FonteUISemiBold}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </Border>
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{Binding Player.TimerSonoIndice, Mode=TwoWay}">
                                <!-- Visual do item selecionado no campo principal do ComboBox -->
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboxItem}">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Background="Transparent" Height="30">
                                                        <TextBlock Text="{Binding}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                                <ComboBoxItem Content="Desativado" />
                                <ComboBoxItem Content="5 min" />
                                <ComboBoxItem Content="10 min" />
                                <ComboBoxItem Content="15 min" />
                                <ComboBoxItem Content="30 min" />
                                <ComboBoxItem Content="45 min" />
                                <ComboBoxItem Content="60 min" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="8,16">
                <Grid.Resources>
                    <Style x:Key="LinkButton" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        <Setter Property="FontFamily" Value="{DynamicResource FonteUIMedium}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="Texto"
                                               Text="{TemplateBinding Content}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Opacity="0.8" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Texto" Property="TextDecorations" Value="Underline" />
                                            <Setter TargetName="Texto" Property="Opacity" Value="1" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Versao, StringFormat='Kitsune v{0}'}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="{DynamicResource FonteUIMedium}" />
                    <TextBlock Text="·" Margin="8,0" Opacity="0.5"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Button Style="{StaticResource LinkButton}"
                            Content="{DynamicResource Str_LicencasTerceiros}"
                            Command="{Binding AbrirLicencasCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{DynamicResource FonteUIMedium}">
                    <Run Text="{Binding Copyright, Mode=OneWay}" />
                    <Run Text="{DynamicResource Str_DireitosReservados}" />
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>