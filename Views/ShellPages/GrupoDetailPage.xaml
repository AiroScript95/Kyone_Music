<UserControl x:Class="KyoneMusic.Views.ShellPages.GrupoDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:KyoneMusic.Views.Controls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:KyoneMusic.Views.ShellPages"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70*" />
            </Grid.ColumnDefinitions>
            <!-- ===== PAINEL LATERAL: capa + controlos ===== -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width"
                                Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlayerViewModel.MusicaAtual, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                                         Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="400"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="0"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Background="{DynamicResource SurfaceAltBrush}" Opacity="0.985"></Grid>
                <controls:PlayerControl />
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== CABEÇALHO: hero com blur ===== -->
                <Border Grid.Row="0" Height="260" Margin="8" Style="{StaticResource BorderClip}" CornerRadius="8">
                    <Grid ClipToBounds="True" Background="{DynamicResource SurfaceOverlayBrush}">
                        <Grid>
                            <Border Background="{Binding Capa, Converter={StaticResource BytesParaGradienteConverter}}" />
                            <Border Background="{DynamicResource SurfaceOverlayBrush}" Opacity="0.45" />
                        </Grid>
                        <Button Command="{Binding VoltarCommand}" Grid.ColumnSpan="3" Panel.ZIndex="2"
                                Style="{StaticResource IconButtonSmall}"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                ToolTip="{DynamicResource Str_Voltar}" Margin="8">
                            <iconPacks:PackIconPhosphorIcons Kind="ArrowUUpLeftBold" Width="18" Height="18" />
                        </Button>
                        <!-- Conteúdo em cima: capa nítida + info -->
                        <Grid Margin="20,26" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="180"
                                    Height="180"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    ClipToBounds="True"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BorderClip}">
                                        <Setter Property="CornerRadius" Value="16" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCircular}" Value="True">
                                                <Setter Property="CornerRadius" Value="90" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                    <iconPacks:PackIconPhosphorIcons Width="56"
                                                                     Height="56"
                                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}">
                                        <iconPacks:PackIconPhosphorIcons.Style>
                                            <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                                <Setter Property="Kind" Value="VinylRecord"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCircular}" Value="True">
                                                        <Setter Property="Kind" Value="MicrophoneFill"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconPhosphorIcons.Style>
                                    </iconPacks:PackIconPhosphorIcons>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,0">
                                <TextBlock FontSize="44" FontWeight="Bold"
                                           FontFamily="{StaticResource FonteZenNew}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           MaxWidth="460"
                                           Margin="0"
                                           TextAlignment="Left"
                                           HorizontalAlignment="Left"
                                           Text="{Binding Nome}"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,4,0,12">
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="14" FontWeight="DemiBold"
                                               Text="{Binding NumMusicas}" />
                                    <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="18" />
                                    <TextBlock Text="{Binding DuracaoTotalFormatada}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="DemiBold" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding TocarOrdemAleatorioCommand}"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            BorderThickness="0" hc:BorderElement.CornerRadius="8" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="Shuffle" Margin="0,0,10,0" />
                                            <TextBlock Text="{DynamicResource Str_Aleatorio}" FontSize="14" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <!-- ===== LISTA DE MÚSICAS ===== -->
                <Grid Grid.Row="2">
                    <Grid Background="{DynamicResource SurfaceOverlayBrush}" Opacity="0.05" />
                    <ListBox x:Name="ScrollPrincipal"  Margin="24" ItemsSource="{Binding Musicas}"
                             Background="Transparent"
                             Padding="8,0"
                             AlternationCount="{Binding Musicas.Count}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             Style="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                             BorderThickness="0">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border CornerRadius="8" MouseLeftButtonUp="StackPanel_MouseLeftButtonUp" Style="{DynamicResource BorderClip}"
                                        ContextMenuOpening="ContextMenu_Opening"
                                        ContextMenu="{StaticResource MusicaContextMenu}"
                                        Tag="{Binding DataContext.PlayerViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid>
                                        <Grid Opacity="1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        </Grid>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="100*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="60"
                                                    Height="60"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    Style="{StaticResource BorderClip}"
                                                    ClipToBounds="True">
                                                <Grid ClipToBounds="True">
                                                    <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=120}"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                    <iconPacks:PackIconPhosphorIcons Kind="MusicNotes"
                                                                                     Width="18"
                                                                                     Height="18"
                                                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"
                                                                                     Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="left"
                                                        Margin="12,0"
                                                        Background="Transparent">
                                                <TextBlock Text="{Binding Titulo}"
                                                           FontWeight="SemiBold"
                                                           FontSize="16"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AccentLightBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,4">
                                                    <TextBlock Text="{Binding Artista}"
                                                               FontSize="12"
                                                               MaxWidth="160"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="•"
                                                               Margin="4,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Album}"
                                                               FontSize="12"
                                                               MaxWidth="160"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border BorderThickness="0"
                                                            Visibility="{Binding TemLetraDisponivel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            CornerRadius="4"
                                                            Margin="0,0,6,0" Padding="4,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                                                <Binding />
                                                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{DynamicResource Str_Letras}"
                                                                   FontSize="11" FontWeight="Regular"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DuracaoArredondada}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <iconPacks:PackIconPhosphorIcons Grid.Column="3"
                                                                             Margin="16,0"
                                                                             Width="18"
                                                                             Height="18"
                                                                             VerticalAlignment="Center">
                                                <iconPacks:PackIconPhosphorIcons.Style>
                                                    <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextMutedBrush}" />
                                                        <Setter Property="Kind"
                                                                Value="Equalizer" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                                        <Binding />
                                                                        <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="Kind"
                                                                        Value="Waveform" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconPhosphorIcons.Style>
                                            </iconPacks:PackIconPhosphorIcons>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>