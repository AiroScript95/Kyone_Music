<UserControl x:Class="KyoneMusic.Views.ShellPages.MusicListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:KyoneMusic.Views.ShellPages"
             xmlns:controls="clr-namespace:KyoneMusic.Views.Controls"
             xmlns:converters="clr-namespace:KyoneMusic.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:viewmodels="clr-namespace:KyoneMusic.ViewModels"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:KyoneMusic.Behaviors"
             xmlns:shellpages="clr-namespace:KyoneMusic.ViewModels.ShellPages"
             d:DataContext="{d:DesignInstance Type=shellpages:MusicListPageViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <UserControl.Resources>

        <DataTemplate x:Key="ListMusicaTemplate">
            <Border CornerRadius="8" Style="{DynamicResource BorderClip}"
                    MouseLeftButtonUp="Music_MouseLeftButtonUp" BorderThickness="1"
                    ContextMenuOpening="ContextMenu_Opening"
                    Background="Transparent"
                    ContextMenu="{StaticResource MusicaContextMenu}"
                    Tag="{Binding DataContext.PlayerViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="14" Margin="5,0,15,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" FontWeight="Regular"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.OrdemAtual,
                                                     RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     Value="MaisTocada">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource IndiceParaNumeroConverter}">
                                    <Binding />
                                    <Binding Path="DataContext.Musicas" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Border Grid.Column="1"
                                Width="60"
                                Height="60"
                                CornerRadius="4"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}"
                                ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=120}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotes"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="left"
                                    Margin="16,0"
                                    Background="Transparent">
                            <TextBlock Text="{Binding Titulo}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Left" Margin="0"
                                       Width="Auto" HorizontalAlignment="Left"
                                       FontFamily="{DynamicResource FonteUISemiBold}"
                                       FontSize="16" MaxWidth="300" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4">
                                <TextBlock Text="{Binding Artista}"
                                           FontWeight="Medium"
                                           FontFamily="{DynamicResource FonteUIMedium}"
                                           FontSize="12"
                                           MaxWidth="160"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="•"
                                           Margin="4,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Album}"
                                           FontWeight="Medium"
                                           FontFamily="{DynamicResource FonteUIMedium}"
                                           FontSize="12"
                                           MaxWidth="160"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border BorderThickness="0"
                                        Visibility="{Binding TemLetraDisponivel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        CornerRadius="4" Width="auto" Height="auto"
                                        Margin="0,0,6,0" Padding="4,1" Background="{DynamicResource SurfaceRaisedBrush}">
                                    <TextBlock Text="{DynamicResource Str_Letras}"
                                               FontSize="12" FontWeight="Light"
                                               FontFamily="{DynamicResource FonteUILight}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="{Binding DuracaoArredondada}"

                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="30,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.OrdemAtual,
                                                     RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     Value="MaisTocada">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding VezesTocada}"
                                       FontSize="14"

                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <iconPacks:PackIconPhosphorIcons Grid.Column="4"
                                                         Margin="16,0"
                                                         Width="18"
                                                         Height="18"
                                                         VerticalAlignment="Center">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextMutedBrush}" />
                                    <Setter Property="Kind"
                                            Value="Waveform" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>

                        <controls:BarrasEqualizador Grid.Column="4" Height="20" Width="20" Margin="16,0" VerticalAlignment="Center"
                                                    Tocando="{Binding DataContext.PlayerViewModel.EstaTocando,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <controls:BarrasEqualizador.Style>
                                <Style TargetType="controls:BarrasEqualizador">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:BarrasEqualizador.Style>
                        </controls:BarrasEqualizador>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CompactMusicaTemplate">
            <Border CornerRadius="8" Style="{DynamicResource BorderClip}"
                    MouseLeftButtonUp="Music_MouseLeftButtonUp" BorderThickness="1"
                    ContextMenuOpening="ContextMenu_Opening"
                    Background="Transparent"
                    ContextMenu="{StaticResource MusicaContextMenu}"
                    Tag="{Binding DataContext.PlayerViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="14" Margin="5,0,15,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" FontWeight="Regular"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.OrdemAtual,
                                                     RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     Value="MaisTocada">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource IndiceParaNumeroConverter}">
                                    <Binding />
                                    <Binding Path="DataContext.Musicas" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="left"
                                    Margin="16,0"
                                    Background="Transparent">
                            <TextBlock Text="{Binding Titulo}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Left" Margin="0"
                                       Width="Auto" HorizontalAlignment="Left"
                                       FontFamily="{DynamicResource FonteUISemiBold}"
                                       FontSize="16" MaxWidth="300" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4">
                                <TextBlock Text="{Binding Artista}"
                                           FontWeight="Medium"
                                           FontFamily="{DynamicResource FonteUIMedium}"
                                           FontSize="12"
                                           MaxWidth="160"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="•"
                                           Margin="4,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Album}"
                                           FontWeight="Medium"
                                           FontFamily="{DynamicResource FonteUIMedium}"
                                           FontSize="12"
                                           MaxWidth="160"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border BorderThickness="0"
                                        Visibility="{Binding TemLetraDisponivel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        CornerRadius="4" Width="auto" Height="auto"
                                        Margin="0,0,6,0" Padding="4,1" Background="{DynamicResource SurfaceRaisedBrush}">
                                    <TextBlock Text="{DynamicResource Str_Letras}"
                                               FontSize="12" FontWeight="Light"
                                               FontFamily="{DynamicResource FonteUILight}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="{Binding DuracaoArredondada}"

                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="30,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.OrdemAtual,
                                                     RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     Value="MaisTocada">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding VezesTocada}"
                                       FontSize="14"

                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <iconPacks:PackIconPhosphorIcons Grid.Column="3"
                                                         Margin="16,0"
                                                         Width="18"
                                                         Height="18"
                                                         VerticalAlignment="Center">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextMutedBrush}" />
                                    <Setter Property="Kind"
                                            Value="Waveform" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>

                        <controls:BarrasEqualizador Grid.Column="3" Height="20" Width="20" Margin="16,0" VerticalAlignment="Center"
                                                    Tocando="{Binding DataContext.PlayerViewModel.EstaTocando,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <controls:BarrasEqualizador.Style>
                                <Style TargetType="controls:BarrasEqualizador">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:BarrasEqualizador.Style>
                        </controls:BarrasEqualizador>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GridMusicaTemplate">
            <Border CornerRadius="8" Style="{StaticResource BorderClip}"
                    MouseLeftButtonUp="Music_MouseLeftButtonUp"
                    ContextMenuOpening="ContextMenu_Opening"
                    ContextMenu="{StaticResource MusicaContextMenu}"
                    Tag="{Binding DataContext.PlayerViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <StackPanel Margin="8">
                        <Border CornerRadius="8" MaxWidth="130" MaxHeight="130"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}"
                                ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=240}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                <iconPacks:PackIconPhosphorIcons Kind="MusicNote"
                                                                 Width="24"
                                                                 Height="24"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />

                                <controls:BarrasEqualizador Height="60" Width="40" Margin="16,0" VerticalAlignment="Center"
                                                            Tocando="{Binding DataContext.PlayerViewModel.EstaTocando,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <controls:BarrasEqualizador.Style>
                                        <Style TargetType="controls:BarrasEqualizador">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:BarrasEqualizador.Style>
                                </controls:BarrasEqualizador>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Titulo}"
                                   FontWeight="SemiBold"
                                   FontSize="14"

                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource AccentLightBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Artista}"
                                   FontSize="14"

                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource TransicaoEntrada}"
          ClipToBounds="True">
        <!-- Conteudo -->
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>

            <!-- ===== PAINEL LATERAL: capa + controlos ===== -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>

                            <DataTrigger Binding="{Binding PlayerViewModel.MusicaAtual, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" Value="Visible">
                                <Setter Property="Margin" Value="0,0,16,0" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="400"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="0"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <controls:PlayerControl />
            </Grid>

            <!-- ===== LISTA À DIREITA ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="65" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="{DynamicResource Str_Musicas}" Style="{StaticResource TitleMain}" />
                    <Button Command="{Binding MostrarPainelOrdenacaoCommand}" Style="{DynamicResource IconButtonSmall}"
                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="25,0">
                        <iconPacks:PackIconPhosphorIcons Kind="SortAscending" Width="20" Height="Auto" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Musicas.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <iconPacks:PackIconPhosphorIcons Kind="MusicNoteFill" Height="50" Width="50" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_NenhumaMusica}"  Margin="0,12" FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Style="{StaticResource ActionButton}"
                                    Command="{Binding IrParaConfiguracoesCommand}"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconPhosphorIcons Kind="FolderFill" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Str_Add_Pasta}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Column="0"
                             x:Name="ListScroll"
                             ClipToBounds="True"
                             ItemsSource="{Binding Musicas}"
                             Padding="16,0,8,8"
                             ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                             AlternationCount="{Binding Musicas.Count}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             Background="Transparent"
                             BorderThickness="0" Margin="8,0,16,0">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                            </Style>
                        </ListBox.Resources>
                        <i:Interaction.Behaviors>
                            <behaviors:ScrollIntoViewBehavior ScrollToItem="{Binding MusicaParaScroll}" />
                        </i:Interaction.Behaviors>
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                                <Setter Property="ItemTemplate" Value="{StaticResource ListMusicaTemplate}" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FormatoLista}" Value="Grid">
                                        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
                                        <Setter Property="ItemTemplate" Value="{StaticResource GridMusicaTemplate}" />
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" ItemSize="160,198" />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FormatoLista}" Value="Compact">
                                        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                                        <Setter Property="ItemTemplate" Value="{StaticResource CompactMusicaTemplate}" />
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <vwp:VirtualizingWrapPanel ItemSize="300,92" StretchItems="True" />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Musicas.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>
                    <Border Grid.Column="1" CornerRadius="8,0,0,8" VerticalAlignment="Center"
                            Background="Transparent" Style="{DynamicResource BorderClip}">
                        <Grid ClipToBounds="True">
                            <Grid Background="{DynamicResource SurfaceOverlayBrush}" Opacity="0.65"></Grid>
                            <ItemsControl ItemsSource="{Binding Alfabeto}"
                                          HorizontalAlignment="Left" Padding="0,6"
                                          VerticalAlignment="Center">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Width" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OrdemAtual}" Value="Alfabetica">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.1">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.1">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Width="25" Background="Transparent" Height="14" TextAlignment="Center"
                                                   FontFamily="{DynamicResource FonteUISemiBold}"
                                                   HorizontalAlignment="Center" Cursor="Hand" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                                    <i:InvokeCommandAction Command="{Binding DataContext.SaltarParaLetraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                           CommandParameter="{Binding}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Height="0"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrush2}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Height" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstaCarregandoMusicas, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Value="Visible">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Height" To="60" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse Width="30" Height="30"
                                 Stroke="{DynamicResource ProgressFillBrush}"
                                 StrokeThickness="4"
                                 StrokeDashArray="10 10"
                                 StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                 Style="{StaticResource Girar}" />
                        <TextBlock Text="{DynamicResource Str_Carregar_biblio}"
                                   Margin="20,0" Style="{StaticResource TituloSecao}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <!--Painel Ordenação-->
        <Grid Background="Transparent" Visibility="{Binding MostrarOrdenacao,Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding FecharPainelOrdenacaoCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Grid>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,60,24,0" RenderTransformOrigin="1,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarOrdenacao}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.95" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.95" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                        Width="260" Padding="0" Style="{StaticResource BorderClip}"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Height" Value="36" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                            <Style x:Key="iconRadio" TargetType="iconPacks:PackIconPhosphorIcons">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Height" Value="16" />
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="FontFamily" Value="{DynamicResource FonteUIMedium}" />
                                <Setter Property="Margin" Value="40,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </Grid.Resources>
                        <StackPanel>
                            <Grid Margin="0,8">
                                <TextBlock Text="{DynamicResource Str_MusicasOrdenadasPor}" FontFamily="{DynamicResource FonteUIMedium}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="16,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Command="{Binding FecharPainelOrdenacaoCommand}"
                                        HorizontalAlignment="Right" Margin="10,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource IconButtonSmall}" Width="24" Height="24">
                                    <iconPacks:PackIconPhosphorIcons Kind="XBold" Width="12" Height="12" />
                                </Button>
                            </Grid>
                            <StackPanel  ClipToBounds="True">
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioAlfabetica">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons  Style="{StaticResource iconRadio}" Kind="TextAaBold" />
                                        <TextBlock Text="{DynamicResource Str_Alfabetica}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioMaisRecente">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="ClockCounterClockwiseBold" />
                                        <TextBlock Text="{DynamicResource Str_Mais_recente}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioMaisTocada">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="FireBold" />
                                        <TextBlock Text="{DynamicResource Str_Mais_Tocada}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioDuracao">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="HourglassBold" />
                                        <TextBlock Text="{DynamicResource Str_Duracao}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioAleatorio">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="DiceFiveBold" />
                                        <TextBlock Text="{DynamicResource Str_Aleatorio}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <Border Background="{DynamicResource BorderBrush2}" Width="Auto" Height="2" CornerRadius="2" Opacity="0.2" />
                            <StackPanel>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Direcao"
                                             x:Name="RadioAscendente">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="ArrowBendLeftUp" />
                                        <TextBlock Text="{DynamicResource Str_Ascendente}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Direcao"
                                             x:Name="RadioDescendete">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="ArrowBendLeftDown" />
                                        <TextBlock Text="{DynamicResource Str_Descendente}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>