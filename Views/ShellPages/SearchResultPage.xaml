<UserControl x:Class="KyoneMusic.Views.ShellPages.SearchResultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:KyoneMusic.Views.ShellPages"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Esconde a secção quando o Tag (Count da coleção) é 0 -->
        <Style x:Key="SecaoStyle" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <system:Int32>0</system:Int32>
                    </Trigger.Value>
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MusicaResultadoTemplate">
            <Border CornerRadius="8" Style="{DynamicResource BorderClip}"
                    MouseLeftButtonUp="Music_MouseLeftButtonUp" BorderThickness="1"
                    ContextMenuOpening="ContextMenu_Opening"
                    ContextMenu="{StaticResource MusicaContextMenu}"
                    Tag="{Binding DataContext.PlayerViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <Grid Opacity="1">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1"
                                Width="60"
                                Height="60"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}"
                                ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=120}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesSimpleFill"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="left"
                                    Margin="12,0"
                                    Background="Transparent">
                            <TextBlock Text="{Binding Titulo}"
                                       FontWeight="SemiBold"
                                       FontSize="14"

                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4">
                                <TextBlock Text="{Binding Artista}"
                                           FontSize="12"
                                           MaxWidth="160"
                                           VerticalAlignment="Center"

                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="•"
                                           Margin="4,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Album}"

                                           FontSize="12"
                                           MaxWidth="160"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border BorderThickness="0"
                                        Visibility="{Binding TemLetraDisponivel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        CornerRadius="4"
                                        Margin="0,0,6,0" Padding="4,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{DynamicResource Str_Letras}"

                                               FontSize="11" FontWeight="Regular"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <TextBlock Text="{Binding DuracaoArredondada}"

                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="30,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.OrdemAtual,
                                                     RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     Value="MaisTocada">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding VezesTocada}"
                                       FontSize="14"

                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <iconPacks:PackIconPhosphorIcons Grid.Column="4"
                                                         Margin="16,0"
                                                         Width="18"
                                                         Height="18"
                                                         VerticalAlignment="Center">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextMutedBrush}" />
                                    <!--<Setter Property="Kind" Value="RegularEqualizer" />-->
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Kind"
                                                    Value="Waveform" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ArtistaCard">
            <Border Width="180" Height="220" Margin="6" CornerRadius="16"
                    ClipToBounds="True" BorderThickness="0"
                    Style="{StaticResource BorderClip}"
                    Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.AbrirArtistaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="100*" />
                    </Grid.RowDefinitions>

                    <!-- Capa -->
                    <Border Grid.Row="0" Width="145" Height="145"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            Style="{StaticResource BorderCircularClip}"
                            HorizontalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <iconPacks:PackIconPhosphorIcons Kind="User" Width="32" Height="32"
                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Nome}" ToolTip="{Binding Nome}"
                                   FontSize="14" FontWeight="DemiBold"

                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding ListaMusicas[0], FallbackValue=''}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"

                                   HorizontalAlignment="Center" Margin="8,2,8,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AlbumCard">
            <Border Height="120" Margin="6" CornerRadius="16"
                    ClipToBounds="True" BorderThickness="0"
                    Style="{StaticResource BorderClip}"
                    Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.AbrirAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid Background="{DynamicResource GradientBackground}" Opacity="0.85" />
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="100" Height="100" CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}">
                            <Grid>
                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                       Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesSimpleFill" Width="32" Height="32"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Border Background="#00000090" CornerRadius="10" Padding="8,2" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding NumMusicas, StringFormat={}{0:D2}}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="DemiBold"

                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,40,4" />
                                <ItemsControl ItemsSource="{Binding ListaMusicas}" Margin="0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesSimpleFill" Width="12" Height="12"
                                                                                 Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Margin="8,0" Text="{Binding}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistCard">
            <Border Height="120" Margin="6" CornerRadius="16"
                    ClipToBounds="True" BorderThickness="0"
                    Style="{StaticResource BorderClip}"
                    Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.AbrirPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Playlist}" />
                </Border.InputBindings>
                <Grid>
                    <Grid Background="{DynamicResource GradientBackground}" Opacity="0.85" />
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="8" Width="100" Height="100" ClipToBounds="True"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}">
                            <Grid>
                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                       Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesSimpleFill" Width="32" Height="32"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Border Background="#00000090" CornerRadius="10" Padding="8,2" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Playlist.NumMusicas, StringFormat={}{0:D2}}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>

                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="DemiBold"

                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Playlist.Name}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Playlist.Name}" Value="Favoritos">
                                                    <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding ListaMusicas}" Margin="0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesSimpleFill" Width="12" Height="12"
                                                                                 Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Margin="8,0" Text="{Binding}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource TitleMain}" />
        </Grid>
        <Grid Grid.Row="1" Margin="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ResultadosMusica.Count}" Value="0" />
                                <Condition Binding="{Binding ResultadosArtistas.Count}" Value="0" />
                                <Condition Binding="{Binding ResultadosAlbuns.Count}" Value="0" />
                                <Condition Binding="{Binding ResultadosPlaylists.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconPhosphorIcons Kind="MagnifyingGlass" Width="80" Height="80"
                                                 Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding TextoSemResultados}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource TituloSecao}" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,16" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" Focusable="False" Template="{StaticResource MeuScrollViewer}" Padding="16" Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25*" />
                    <RowDefinition Height="25*" />
                    <RowDefinition Height="25*" />
                    <RowDefinition Height="25*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>
                <!-- Músicas (lista, com scroll próprio para manter a virtualização) -->
                <StackPanel Grid.Row="0" Style="{StaticResource SecaoStyle}" Tag="{Binding ResultadosMusica.Count}">
                    <Grid Margin="0,8">
                        <TextBlock Text="{DynamicResource Str_Musicas}" Margin="16,0" Style="{StaticResource TituloSecao}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Button Command="{Binding VerMaisMusicasCommand}" HorizontalAlignment="Right"
                                Visibility="{Binding verTodasMusicas, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource IconButton}" Width="auto" FontSize="12" Padding="16,4"
                                VerticalAlignment="Center"
                                Height="30">
                            <TextBlock Text="{DynamicResource Str_VerMais}" TextDecorations="Underline" />
                        </Button>
                    </Grid>
                    <ListBox Style="{x:Null}"
                             ItemsSource="{Binding ResultadosMusica}"
                             ItemTemplate="{StaticResource MusicaResultadoTemplate}"
                             ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                             Margin="6,0"
                             Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </StackPanel>

                <!-- Artistas -->
                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource SecaoStyle}" Tag="{Binding ResultadosArtistas.Count}" Margin="0,16,0,0">
                    <Grid Margin="0,8">
                        <TextBlock Text="{DynamicResource Str_Artistas}" Margin="16,0" Style="{StaticResource TituloSecao}" />
                        <Button Command="{Binding VerMaisArtistasCommand}" HorizontalAlignment="Right"
                                Style="{StaticResource IconButton}" Width="auto" FontSize="12" Padding="16,4"
                                VerticalAlignment="Center"
                                Visibility="{Binding verTodosArtistas, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Height="30">
                            <TextBlock Text="{DynamicResource Str_VerMais}" TextDecorations="Underline" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ResultadosArtistas}"
                                  ItemTemplate="{StaticResource ArtistaCard}"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel ItemSize="192,232" StretchItems="True" MaxHeight="600" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Álbuns -->
                <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource SecaoStyle}" Tag="{Binding ResultadosAlbuns.Count}" Margin="0,16,0,0">
                    <Grid Margin="0,8">
                        <TextBlock Text="{DynamicResource Str_Albuns}" Margin="16,0" Style="{StaticResource TituloSecao}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Button Command="{Binding VerMaisAlbunsCommand}" HorizontalAlignment="Right"
                                Visibility="{Binding verTodosAlbuns, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource IconButton}" Width="auto" FontSize="12" Padding="16,4"
                                VerticalAlignment="Center"
                                Height="30">
                            <TextBlock Text="{DynamicResource Str_VerMais}" TextDecorations="Underline" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ResultadosAlbuns}"
                                  ItemTemplate="{StaticResource AlbumCard}"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel ItemSize="332,132" StretchItems="True" MaxHeight="600" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Playlists -->
                <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource SecaoStyle}" Tag="{Binding ResultadosPlaylists.Count}" Margin="0,16,0,0">
                    <Grid Margin="0,8">
                        <TextBlock Text="{DynamicResource Str_Playlists}" Margin="16,0" Style="{StaticResource TituloSecao}" />
                        <Button Command="{Binding VerMaisPlaylistCommand}" HorizontalAlignment="Right"
                                Visibility="{Binding verTodosPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource IconButtonSmall}" Width="auto" FontSize="12" Padding="16,4"
                                VerticalAlignment="Center"
                                Height="30">
                            <TextBlock Text="{DynamicResource Str_VerMais}" TextDecorations="Underline" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ResultadosPlaylists}"
                                  ItemTemplate="{StaticResource PlaylistCard}"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel ItemSize="332,132" StretchItems="True" MaxHeight="600" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>