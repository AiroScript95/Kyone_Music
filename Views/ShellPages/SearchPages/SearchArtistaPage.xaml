<UserControl x:Class="KyoneMusic.Views.ShellPages.SearchPages.SearchArtistaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:local="clr-namespace:KyoneMusic.Views.ShellPages.SearchPages"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <DataTemplate x:Key="ArtistaCard">
            <Border Width="180" Height="220" Margin="6" CornerRadius="16"
                    ClipToBounds="True" BorderThickness="0"
                    Style="{StaticResource BorderClip}"
                    Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.AbrirArtistaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="100*" />
                    </Grid.RowDefinitions>

                    <!-- Capa -->
                    <Border Grid.Row="0" Width="145" Height="145"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            Style="{StaticResource BorderCircularClip}"
                            HorizontalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <iconPacks:PackIconPhosphorIcons Kind="User" Width="32" Height="32"
                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Nome}" ToolTip="{Binding Nome}"
                                   FontSize="14" FontWeight="DemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding ListaMusicas[0], FallbackValue=''}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" Margin="8,2,8,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding VoltarCommand}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderThickness="0"
                        Width="40" Height="40"
                        hc:BorderElement.CornerRadius="50"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                    <iconPacks:PackIconPhosphorIcons Kind="ArrowUUpLeftBold" Width="18" Height="18" />
                </Button>
                <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource TitleMain}"/>
            </StackPanel>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultadosArtistas}"
                      ItemTemplate="{StaticResource ArtistaCard}" Padding="8" Margin="8"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Focusable="False"
                                  Template="{StaticResource MeuScrollViewer}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel ItemSize="192,232" StretchItems="True" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>