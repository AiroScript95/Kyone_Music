<UserControl x:Class="Project_Kitsune.Views.ShellPages.SearchPages.SearchMusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:Project_Kitsune.Views.ShellPages"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <DataTemplate x:Key="MusicaResultadoTemplate">
            <Border CornerRadius="8" Style="{DynamicResource BorderClip}"
                    MouseLeftButtonUp="Music_MouseLeftButtonUp" BorderThickness="1"
                    ContextMenuOpening="ContextMenu_Opening"
                    ContextMenu="{StaticResource MusicaContextMenu}"
                    Tag="{Binding DataContext.PlayerViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <Grid Opacity="0.65">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="{DynamicResource GradientBackground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="60" Height="60" CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}">
                            <Grid>
                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=120}"
                                       Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <iconPacks:PackIconBoxIcons Kind="RegularMusic" Width="18" Height="18"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="{StaticResource FonteInter}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Artista}" FontSize="12" MaxWidth="150"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="•" Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Album}" FontSize="12" MaxWidth="150"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding DuracaoArredondada}" FontSize="11"
                                   Margin="10,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FonteInter}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding VoltarCommand}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderThickness="0"
                        Width="40" Height="40"
                        hc:BorderElement.CornerRadius="50"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                    <iconPacks:PackIconBoxIcons Kind="SolidUndo" />
                </Button>
                <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource ConfigSectionTitle}" Margin="20,0,0,0"
                           FontSize="24" FontWeight="Bold"
                           FontFamily="{StaticResource FonteHiragino}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ListBox Style="{x:Null}"
                 Grid.Row="1"
                 ItemsSource="{Binding ResultadosMusica}"
                 ItemTemplate="{StaticResource MusicaResultadoTemplate}"
                 ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                 Margin="8" Padding="8"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.Resources>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                </Style>
            </ListBox.Resources>
        </ListBox>
    </Grid>
</UserControl>