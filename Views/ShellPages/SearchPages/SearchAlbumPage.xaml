<UserControl x:Class="KyoneMusic.Views.ShellPages.SearchPages.SearchAlbumPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:searchpages="clr-namespace:KyoneMusic.ViewModels.ShellPages.SearchPages"
             d:DataContext="{d:DesignInstance Type=searchpages:SearchAlbumPageViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate x:Key="AlbumCard">
            <Border Height="120" Margin="6" CornerRadius="16"
                    ClipToBounds="True" BorderThickness="0"
                    Style="{StaticResource BorderClip}"
                    Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.AbrirAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid Background="{DynamicResource GradientBackground}" Opacity="0.85" />
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="100" Height="100" CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}">
                            <Grid>
                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                       Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <iconPacks:PackIconPhosphorIcons Kind="MusicNote" Width="32" Height="32"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Border Background="#00000090" CornerRadius="10" Padding="8,2" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding NumMusicas, StringFormat={}{0:D2}}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="DemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,40,4" />
                                <ItemsControl ItemsSource="{Binding ListaMusicas}" Margin="0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <iconPacks:PackIconPhosphorIcons Kind="MusicNote" Width="12" Height="12"
                                                                                 Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Margin="8,0" Text="{Binding}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding VoltarCommand}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderThickness="0"
                        Width="40" Height="40"
                        hc:BorderElement.CornerRadius="50"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                    <iconPacks:PackIconPhosphorIcons Kind="ArrowUUpLeftBold" Width="18" Height="18" />
                </Button>
                <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource TitleMain}" />
            </StackPanel>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultadosAlbuns}"
                      ItemTemplate="{StaticResource AlbumCard}" Padding="8" Margin="8"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Focusable="False"
                                  Template="{StaticResource MeuScrollViewer}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel ItemSize="332,132" StretchItems="True" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>