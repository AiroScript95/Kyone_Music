<UserControl x:Class="Project_Kitsune.Views.ShellPages.SearchPages.SearchPlaylistPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:Project_Kitsune.Views.ShellPages.SearchPages"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <DataTemplate x:Key="PlaylistCard">
            <Border Height="120" Margin="6" CornerRadius="16"
                    ClipToBounds="True" BorderThickness="0"
                    Style="{StaticResource BorderClip}"
                    Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.AbrirPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Playlist}" />
                </Border.InputBindings>
                <Grid>
                    <Grid Background="{DynamicResource GradientBackground}" Opacity="0.85" />
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="8" Width="100" Height="100" ClipToBounds="True"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}">
                            <Grid>
                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                       Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <iconPacks:PackIconBoxIcons Kind="RegularListMusic" Width="32" Height="32"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Border Background="#00000090" CornerRadius="10" Padding="8,2" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Playlist.NumMusicas, StringFormat={}{0:D2}}"
                                           FontFamily="{StaticResource FonteInter}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>

                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="DemiBold"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Playlist.Name}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Playlist.Name}" Value="Favoritos">
                                                    <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding ListaMusicas}" Margin="0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <iconPacks:PackIconBoxIcons Kind="RegularMusicAlt" Width="12" Height="12"
                                                                            Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Margin="8,0" Text="{Binding}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding VoltarCommand}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderThickness="0"
                        Width="40" Height="40"
                        hc:BorderElement.CornerRadius="50"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                    <iconPacks:PackIconBoxIcons Kind="SolidUndo" />
                </Button>
                <TextBlock Text="{Binding Titulo}" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource ConfigSectionTitle}" Margin="20,0,0,0"
                           FontSize="24" FontWeight="Bold"
                           FontFamily="{StaticResource FonteHiragino}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultadosPlaylists}"
                      ItemTemplate="{StaticResource PlaylistCard}"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel ItemSize="332,132" StretchItems="True" MaxHeight="600" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>