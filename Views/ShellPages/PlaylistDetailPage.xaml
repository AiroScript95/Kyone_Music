<UserControl x:Class="KyoneMusic.Views.ShellPages.PlaylistDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shellpages="clr-namespace:KyoneMusic.ViewModels.ShellPages"
             xmlns:controls="clr-namespace:KyoneMusic.Views.Controls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">

    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70*" />
            </Grid.ColumnDefinitions>
            <!-- ===== PAINEL LATERAL: capa + controlos ===== -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width"
                                Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlayerViewModel.MusicaAtual, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                                         Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="400"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="0"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <controls:PlayerControl />
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== CABEÇALHO: hero com blur ===== -->
                <Border Grid.Row="0" Height="260" CornerRadius="8" Style="{StaticResource BorderClip}" Margin="8">
                    <Grid  ClipToBounds="True" Background="{DynamicResource SurfaceOverlayBrush}">
                        <Grid>
                            <Border Background="{Binding Capa, Converter={StaticResource BytesParaGradienteConverter}}" />
                            <Border Background="{DynamicResource SurfaceOverlayBrush}" Opacity="0.45" />
                        </Grid>
                        <Button Command="{Binding VoltarCommand}" Grid.ColumnSpan="3" Panel.ZIndex="2"
                                Style="{StaticResource IconButtonSmall}"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                ToolTip="{DynamicResource Str_Voltar}" Margin="8">
                            <iconPacks:PackIconPhosphorIcons Kind="ArrowUUpLeftBold" Width="18" Height="18" />
                        </Button>

                        <StackPanel Grid.ColumnSpan="3" Panel.ZIndex="2" Margin="10" Orientation="Horizontal"
                                    VerticalAlignment="Top" HorizontalAlignment="Right">
                            <Button Command="{Binding AbrirPainelRemoverCommand}" Margin="10,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EhComLetra}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <iconPacks:PackIconPhosphorIcons Kind="Broom" Width="18" Height="18" />
                            </Button>
                            <Button Command="{Binding MostrarPainelOrdenacaoCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EhComLetra}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <iconPacks:PackIconPhosphorIcons Kind="SortAscending" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                        <!-- Conteúdo em cima: capa nítida + info -->
                        <Grid Margin="20,26" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="180" Height="180" CornerRadius="14"
                                    Style="{StaticResource BorderClip}"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    ClipToBounds="True"
                                    VerticalAlignment="Bottom" Margin="0,0,0,0">
                                <Grid>
                                    <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=240}"
                                           Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <iconPacks:PackIconPhosphorIcons Kind="PlaylistBold" Width="56" Height="56"
                                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,0">
                                <TextBlock  FontSize="44" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           MaxWidth="460"
                                           Margin="0"
                                           TextAlignment="Left"
                                           HorizontalAlignment="Left"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding NomePlaylist}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NomePlaylist}" Value="Favoritos">
                                                    <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="8,4,0,12">
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding NumMusicas}"
                                               FontSize="14" FontWeight="DemiBold" />
                                    <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                                    <TextBlock Text="{Binding DuracaoTotalFormatada}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="DemiBold" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding TocarOrdemAleatorioCommand}"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            BorderThickness="0" hc:BorderElement.CornerRadius="8" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="Shuffle" Margin="0,0,10,0" />
                                            <TextBlock Text="{DynamicResource Str_Aleatorio}" FontSize="14" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding AbrirPainelAdicionarCommand}" Margin="4,0"
                                            HorizontalAlignment="Left"
                                            BorderThickness="0" hc:BorderElement.CornerRadius="8" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EhComLetra}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconPhosphorIcons Kind="Plus" Margin="0,0,10,0" />
                                            <TextBlock Text="{DynamicResource Str_Add_Musica}" FontSize="14" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <!-- ===== LISTA DE MÚSICAS ===== -->
                <Grid Grid.Row="2">
                    <Grid Background="{DynamicResource SurfaceOverlayBrush}" Opacity="0.05" />
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Musicas.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <iconPacks:PackIconPhosphorIcons
                                Kind="MusicNoteFill" HorizontalAlignment="Center"
                                Width="40" Height="40"
                                Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Str_PlaylistVazia}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EhFavoritos}" Value="true">
                                                <Setter Property="Text" Value="{DynamicResource Str_SemFavoritos}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="ScrollPrincipal"  Margin="24" ItemsSource="{Binding Musicas}"
                             Background="Transparent"
                             Padding="8,0"
                             AlternationCount="{Binding Musicas.Count}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Style="{x:Null}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                             BorderThickness="0">

                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" MouseLeftButtonUp="Musica_MouseLeftButtonUp"
                                        Style="{DynamicResource BorderClip}" ContextMenuOpening="ContextMenu_Opening"
                                        Tag="{Binding DataContext.PlayerViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem ItemsSource="{Binding PlacementTarget.Tag.PlaylistsDisponiveis,
                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Header>
                                                    <Grid>
                                                        <TextBlock Text="{DynamicResource Str_AdicionarAPlaylist}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <iconPacks:PackIconPhosphorIcons Kind="ListPlus" HorizontalAlignment="Right"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                                    </Grid>
                                                </MenuItem.Header>
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                        <Setter Property="Command"
                                                                Value="{Binding PlacementTarget.Tag.AdicionarAPlaylistCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="CommandParameter">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource MusicaEPlaylistConverter}">
                                                                    <Binding Path="PlacementTarget.DataContext"
                                                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                                    <Binding />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                                <MenuItem.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Name}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Name}" Value="Favoritos">
                                                                            <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </MenuItem.ItemTemplate>
                                            </MenuItem>

                                            <MenuItem Command="{Binding PlacementTarget.Tag.EditarMusicaCommand,
                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Header>
                                                    <Grid>
                                                        <TextBlock Text="{DynamicResource Str_Editar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <iconPacks:PackIconPhosphorIcons Kind="Pencil" HorizontalAlignment="Right"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                                    </Grid>
                                                </MenuItem.Header>
                                            </MenuItem>

                                            <MenuItem Click="RemoverMusica_Click" x:Name="ItemRemover">
                                                <MenuItem.Header>
                                                    <Grid>
                                                        <TextBlock Text="{DynamicResource Str_RemoverDaPlaylist}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <iconPacks:PackIconPhosphorIcons Kind="ListBullets" HorizontalAlignment="Right"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                                    </Grid>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.PedirEliminarMusicaCommand,
                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Header>
                                                    <Grid>
                                                        <TextBlock Text="{DynamicResource Str_Eliminar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <iconPacks:PackIconPhosphorIcons Kind="Trash" HorizontalAlignment="Right"
                                                                                         VerticalAlignment="Center"
                                                                                         Foreground="{DynamicResource TextError}" Width="14" />
                                                    </Grid>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid Opacity="1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        </Grid>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="100*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Margin="8,0,16,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.OrdemAtual,
                                                                         RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                         Value="MaisTocada">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource IndiceParaNumeroConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.Musicas" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Border Grid.Column="1"
                                                    Width="60"
                                                    Height="60"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    Style="{StaticResource BorderClip}"
                                                    ClipToBounds="True">
                                                <Grid ClipToBounds="True">
                                                    <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=120}"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                    <iconPacks:PackIconPhosphorIcons Kind="MusicNotesFill"
                                                                                     Width="18"
                                                                                     Height="18"
                                                                                     Foreground="{DynamicResource TextMutedBrush}"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"
                                                                                     Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="left"
                                                        Margin="12,0"
                                                        Background="Transparent">
                                                <TextBlock Text="{Binding Titulo}"
                                                           FontWeight="SemiBold"
                                                           FontSize="16"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AccentLightBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,4">
                                                    <TextBlock Text="{Binding Artista}"
                                                               FontSize="12"
                                                               MaxWidth="160"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="•"
                                                               Margin="4,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Album}"
                                                               FontSize="12"
                                                               MaxWidth="160"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border BorderThickness="0"
                                                            Visibility="{Binding TemLetraDisponivel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            CornerRadius="4"
                                                            Margin="0,0,6,0" Padding="4,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                                                <Binding />
                                                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{DynamicResource Str_Letras}"
                                                                   FontSize="11" FontWeight="Regular"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DuracaoArredondada}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="30,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.OrdemAtual,
                                                                         RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                         Value="MaisTocada">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="{Binding VezesTocada}"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <iconPacks:PackIconPhosphorIcons Grid.Column="4"
                                                                             Margin="16,0"
                                                                             Width="18"
                                                                             Height="18"
                                                                             VerticalAlignment="Center">
                                                <iconPacks:PackIconPhosphorIcons.Style>
                                                    <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextMutedBrush}" />
                                                        <Setter Property="Kind"
                                                                Value="Equalizer" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                                        <Binding />
                                                                        <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="Kind"
                                                                        Value="Waveform" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconPhosphorIcons.Style>
                                            </iconPacks:PackIconPhosphorIcons>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
        <!-- ===== OVERLAY: Ordenar músicas ===== -->
        <Grid Background="Transparent" Visibility="{Binding MostrarOrdenacao,Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding FecharPainelOrdenacaoCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Grid>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,60,24,0" RenderTransformOrigin="1,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarOrdenacao}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.95" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.95" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                        Width="260" Padding="0" Style="{StaticResource BorderClip}"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Height" Value="36" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                            <Style x:Key="iconRadio" TargetType="iconPacks:PackIconPhosphorIcons">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Height" Value="16" />
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Margin" Value="40,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </Grid.Resources>
                        <StackPanel>
                            <Grid Margin="0,8">
                                <TextBlock Text="{DynamicResource Str_MusicasOrdenadasPor}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="20,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Command="{Binding FecharPainelOrdenacaoCommand}" HorizontalAlignment="Right" Margin="10,0"  VerticalAlignment="Center"
                                        Style="{StaticResource IconButtonSmall}" Width="24" Height="24">
                                    <iconPacks:PackIconPhosphorIcons Kind="XFill" Width="12" Height="12" />
                                </Button>
                            </Grid>
                            <StackPanel  ClipToBounds="True">
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioAlfabetica">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="TextAaBold" />
                                        <TextBlock Text="{DynamicResource Str_Alfabetica}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioMaisRecente">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="ClockCounterClockwiseBold" />
                                        <TextBlock Text="{DynamicResource Str_Mais_recente}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioMaisTocada">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="FireBold" />
                                        <TextBlock Text="{DynamicResource Str_Mais_Tocada}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioDuracao">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="HourglassBold" />
                                        <TextBlock Text="{DynamicResource Str_Duracao}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioAleatorio">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="DiceFiveBold" />
                                        <TextBlock Text="{DynamicResource Str_Aleatorio}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <Border Background="{DynamicResource BorderBrush2}" Width="Auto" Height="2" CornerRadius="2" Opacity="0.2" />
                            <StackPanel>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Direcao"
                                             x:Name="RadioAscendente">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="ArrowBendLeftUp" />
                                        <TextBlock Text="{DynamicResource Str_Ascendente}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Direcao"
                                             x:Name="RadioDescendete">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconPhosphorIcons Style="{StaticResource iconRadio}" Kind="ArrowBendLeftDown" />
                                        <TextBlock Text="{DynamicResource Str_Descendente}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== OVERLAY: adicionar música ===== -->
        <Border Grid.RowSpan="5" Visibility="{Binding MostrarPainelAdicionar, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid Background="{DynamicResource SurfaceBrush}" Opacity="1" />
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Str_Add_Musica}"
                                   Style="{StaticResource TitleMain}" Margin="20,10" FontSize="24" />
                        <Button Command="{Binding FecharPainelAdicionarCommand}"
                                Style="{StaticResource IconButtonSmall}"
                                HorizontalAlignment="Right">
                            <iconPacks:PackIconPhosphorIcons Kind="X" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- NOVO: caixa de pesquisa -->
                    <Border Grid.Row="1" Height="42" CornerRadius="10"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            Margin="20,12">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconPhosphorIcons Grid.Column="0" Kind="MagnifyingGlass"
                                                             Width="16" Height="16"
                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding TextoPesquisaAdicionar, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="ListaTodasMusicas" Grid.Row="2"
                             ItemsSource="{Binding TodasAsMusicas}"
                             SelectionMode="Multiple"
                             SelectionChanged="ListaTodasMusicas_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,0,10,0"
                             Style="{x:Null}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource HoverListBoxItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <!-- checkbox -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- capa -->
                                        <ColumnDefinition Width="100*" />
                                        <ColumnDefinition Width="Auto" />
                                        <!-- duração -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox visual, reflete IsSelected do ListBoxItem -->
                                    <Border Grid.Column="0" Width="20" Height="20"
                                            CornerRadius="5"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <iconPacks:PackIconPhosphorIcons Kind="Check" Width="12" Height="12"
                                                                         Foreground="{DynamicResource TextOnAccentBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <iconPacks:PackIconPhosphorIcons.Style>
                                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconPhosphorIcons.Style>
                                        </iconPacks:PackIconPhosphorIcons>
                                    </Border>

                                    <Border Grid.Column="1" Width="52" Height="52"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            Style="{StaticResource BorderClip}"
                                            ClipToBounds="True">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=240}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <iconPacks:PackIconPhosphorIcons Kind="MusicNotesFill"
                                                                             Width="16" Height="16"
                                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0" Background="Transparent">
                                        <TextBlock Text="{Binding Titulo}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Artista}"
                                                       FontSize="12"
                                                       MaxWidth="150"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="•" Margin="4,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Album}"
                                                       FontSize="12"
                                                       MaxWidth="150"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderThickness="0"
                                                Visibility="{Binding TemLetraDisponivel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CornerRadius="4" Padding="0,1"
                                                Margin="0,0,6,0" MaxWidth="40"
                                                HorizontalAlignment="Left"
                                                BorderBrush="{DynamicResource SecondaryBorderBrush}">
                                            <TextBlock Text="{DynamicResource Str_Letras}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="6,0" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding DuracaoArredondada}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="10,0,4,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="{Binding NumeroSelecionadas, StringFormat='{}{0} selecionadas'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Button Content="{DynamicResource Str_Concluir}"
                                Click="ConfirmarSelecao_Click"
                                HorizontalAlignment="Right"
                                Width="Auto" Height="Auto" FontSize="14"
                                Style="{StaticResource ActionButton}"
                                BorderThickness="0" Cursor="Hand" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== OVERLAY: Remover músicas ===== -->
        <Border Grid.RowSpan="5" Visibility="{Binding MostrarPainelRemover, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid Background="{DynamicResource SurfaceBrush}" Opacity="1" />
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Str_RemoverDaPlaylist}"
                                   Style="{StaticResource TitleMain}" Margin="20,10" FontSize="24" />
                        <Button Command="{Binding FecharPainelRemoverCommand}"
                                Style="{StaticResource IconButtonSmall}"
                                HorizontalAlignment="Right">
                            <iconPacks:PackIconPhosphorIcons Kind="X" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- NOVO: caixa de pesquisa -->
                    <Border Grid.Row="1" Height="42" CornerRadius="10"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            Margin="20,12">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconPhosphorIcons Grid.Column="0" Kind="MagnifyingGlass"
                                                             Width="16" Height="16"
                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding TextoPesquisaRemover, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="ListaParaRemover" Grid.Row="2"
                             ItemsSource="{Binding MusicasDaPlaylist}"
                             SelectionMode="Multiple"
                             SelectionChanged="ListaParaRemover_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,0,10,0"
                             Style="{x:Null}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource HoverListBoxItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <!-- checkbox -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- capa -->
                                        <ColumnDefinition Width="100*" />
                                        <ColumnDefinition Width="Auto" />
                                        <!-- duração -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox visual, reflete IsSelected do ListBoxItem -->
                                    <Border Grid.Column="0" Width="20" Height="20"
                                            CornerRadius="5"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <iconPacks:PackIconPhosphorIcons Kind="Check" Width="12" Height="12"
                                                                         Foreground="{DynamicResource TextOnAccentBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <iconPacks:PackIconPhosphorIcons.Style>
                                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconPhosphorIcons.Style>
                                        </iconPacks:PackIconPhosphorIcons>
                                    </Border>

                                    <Border Grid.Column="1" Width="52" Height="52"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            Style="{StaticResource BorderClip}"
                                            ClipToBounds="True">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=240}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <iconPacks:PackIconPhosphorIcons Kind="MusicNotesFill"
                                                                             Width="16" Height="16"
                                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0" Background="Transparent">
                                        <TextBlock Text="{Binding Titulo}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Artista}"
                                                       FontSize="12"
                                                       MaxWidth="150"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="•" Margin="4,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Album}"
                                                       FontSize="12"
                                                       MaxWidth="150"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderThickness="0"
                                                Visibility="{Binding TemLetraDisponivel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CornerRadius="4" Padding="0,1"
                                                Margin="0,0,6,0" MaxWidth="40"
                                                HorizontalAlignment="Left"
                                                BorderBrush="{DynamicResource SecondaryBorderBrush}">
                                            <TextBlock Text="{DynamicResource Str_Letras}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="6,0" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding DuracaoArredondada}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="10,0,4,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="{Binding NumeroSelecionadas, StringFormat='{}{0} selecionadas'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Button Content="{DynamicResource Str_Concluir}"
                                Click="ConfirmarRemocao_Click"
                                HorizontalAlignment="Right"
                                Width="Auto" Height="Auto" FontSize="14"
                                Style="{StaticResource ActionButton}"
                                BorderThickness="0" Cursor="Hand" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>