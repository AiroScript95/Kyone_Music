<Window x:Class="Project_Kitsune.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:Project_Kitsune.Views"
        xmlns:converters="clr-namespace:Project_Kitsune.Converters"
        xmlns:viewmodels="clr-namespace:Project_Kitsune.ViewModels"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        d:DataContext="{d:DesignInstance Type=viewmodels:PlayerViewModel}"
        mc:Ignorable="d"
        WindowState="Normal"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="Transparent"
        Title="{Binding MusicaAtual.Titulo, FallbackValue='Kitsune - Mini Player'}"
        Height="180" Width="420">
    <Grid Background="{DynamicResource SurfaceBrush}" x:Name="Raiz">
        <Grid Background="Transparent" Panel.ZIndex="1" Height="40" VerticalAlignment="Top"
              MouseLeftButtonDown="Topo_MouseLeftButtonDown">
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                    Margin="0,5,5,0" Height="34" Width="34" Click="Button_Click">
                <iconPacks:PackIconBoxIcons Kind="SolidX" Width="14" />
            </Button>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Capa expandida no topo -->
                <ColumnDefinition Width="Auto" />
                <!-- Detalhes e Controles na parte inferior -->
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>

            <!-- 1. CAPA (Preenche a largura proporcionalmente) -->
            <Border Grid.Column="0" Width="140" Height="140" Margin="12,0,0,0"
                    Background="{DynamicResource SurfaceAltBrush}"
                    ClipToBounds="True"
                    Style="{StaticResource BorderCircularClip}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform x:Name="Rotacao" Angle="0" />
                </Border.RenderTransform>
                <Grid ClipToBounds="True">
                    <Image HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Source="{Binding MusicaAtual.Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=240}"
                           Stretch="UniformToFill" />
                    <iconPacks:PackIconBoxIcons Width="48"
                                                Height="48"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Kind="SolidMusic"
                                                Visibility="{Binding MusicaAtual.Image, Converter={StaticResource NullToVisibilityConverter}}" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding TemLetra, Converter={StaticResource Boolean2VisibilityReConverter}}">

                <StackPanel>
                    <iconPacks:PackIconBoxIcons Kind="RegularSearchBig" Width="40" Height="80"
                                                HorizontalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}" />
                    <TextBlock Text="{DynamicResource Str_Sem_Letra}" FontFamily="{StaticResource FonteInter}"  HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextDisabledBrush}" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer x:Name="ScrollLetras" Grid.Column="1"
                          VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" Height="140" Margin="16,8"
                          Visibility="{Binding TemLetra, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl x:Name="ItemsLetras" ItemsSource="{Binding LetraAtual.Linhas}" Margin="0,36,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Texto}"
                                       FontFamily="{StaticResource FonteInter}"
                                       TextWrapping="Wrap" Margin="0,6" Cursor="Hand"
                                       MouseLeftButtonUp="LinhaLetra_Click" TextAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Setter Property="FontSize" Value="16" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Opacity" Value="0.5" />
                                        <Style.Triggers>
                                            <!-- Hover: só nas linhas que não são a atual, em letra sincronizada -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Value="False">
                                                        <Condition.Binding>
                                                            <MultiBinding Converter="{StaticResource LinhaAtualConverter}">
                                                                <Binding />
                                                                <Binding Path="DataContext.LinhaAtual" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Condition.Binding>
                                                    </Condition>
                                                    <Condition Binding="{Binding DataContext.LetraAtual.Sincronizada, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.25" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.5" FillBehavior="Stop" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>

                                            <!-- Linha atual -->
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource LinhaAtualConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.LinhaAtual" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.5" FillBehavior="Stop" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>

                                            <!-- Não sincronizada -->
                                            <DataTrigger Binding="{Binding DataContext.LetraAtual.Sincronizada, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid>
            <Border Background="{DynamicResource SurfaceOverlayBrush}" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Raiz}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard BeginTime="0:0:1.5">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Painel que sobe de baixo -->
            <StackPanel Margin="16,0,16,8" VerticalAlignment="Bottom">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="30" />
                </StackPanel.RenderTransform>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Raiz}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard BeginTime="0:0:1.5">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <system:Boolean>True</system:Boolean>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                             To="30" Duration="0:0:0.2" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="IsHitTestVisible">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <system:Boolean>False</system:Boolean>
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Título e Artista -->
                <StackPanel Margin="0,0,0,04">
                    <TextBlock FontFamily="{StaticResource FonteInter}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding MusicaAtual.Titulo, FallbackValue='Nenhuma música'}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontFamily="{StaticResource FonteInter}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding MusicaAtual.Artista}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Slider de Progresso -->
                <Slider Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        Maximum="{Binding DuracaoTotalMs}"
                        Minimum="0"
                        PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="Slider_PreviewMouseUp"
                        PreviewMouseMove="Slider_PreviewMouseMove"
                        PreviewMouseUp="Slider_PreviewMouseUp"
                        Style="{StaticResource PrettySlider}"
                        Value="{Binding PosicaoAtualMs}" />

                <!-- Tempos decorrido e total -->
                <Grid Margin="2,2,2,0">
                    <TextBlock HorizontalAlignment="Left"
                               FontFamily="{StaticResource FonteJetBrains}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding TempoAtualFormatado, FallbackValue='00:00'}" />
                    <TextBlock HorizontalAlignment="Right"
                               FontFamily="{StaticResource FonteJetBrains}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding TempoTotalFormatado, FallbackValue='00:00'}" />
                </Grid>

                <!-- Botões de Reprodução -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,0" HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Margin="0,0"
                            Command="{Binding AnteriorCommand}"
                            Style="{StaticResource PlayerControlButton}">
                        <iconPacks:PackIconBoxIcons Width="24"
                                                    Height="24"
                                                    Kind="SolidSkipPrevious" />
                    </Button>

                    <Button Margin="8,0"
                            Command="{Binding AlternarPlayPauseCommand}"
                            Style="{StaticResource PlayerPlayButton}">
                        <iconPacks:PackIconBoxIcons Width="26" Height="26">
                            <iconPacks:PackIconBoxIcons.Style>
                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                    <Setter Property="Kind" Value="SolidPlay" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstaTocando}" Value="True">
                                            <Setter Property="Kind" Value="SolidPause" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconBoxIcons.Style>
                        </iconPacks:PackIconBoxIcons>
                    </Button>

                    <Button Margin="0,0"
                            Command="{Binding ProximaCommand}"
                            Style="{StaticResource PlayerControlButton}">
                        <iconPacks:PackIconBoxIcons Width="24"
                                                    Height="24"
                                                    Kind="SolidSkipNext" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>