<Window x:Class="KyoneMusic.Views.EditarLetraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Editar letra" Height="600" Width="900"
        MinHeight="540" MinWidth="650"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SalvarCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="LetraTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>
        <DockPanel x:Name="RootPanel" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Margin="0" Height="50" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- タイトル文字列（WindowChromeがnullのときも出たまま） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0">
                    <TextBlock Text="{StaticResource Str_Editar}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0"
                               FontSize="16" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- トグルボタン（必要に応じて表示/非表示を切り替え可能） -->
                <Grid Grid.Column="1"></Grid>

                <!-- コントロールボックス（★ UseCustomTitleBar が False のときは非表示にする） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0" Background="Transparent">

                    <!-- 最小化 -->
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WinCaptionStyle}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE921;"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Minimize_Click"
                            ToolTip="最小化" />

                    <!-- 最大化 -->
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WinCaptionStyle}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE922;"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Maximize_Click"
                            ToolTip="最大化" />

                    <!-- 閉じる -->
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WinCaptionStyle}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click"
                            ToolTip="閉じる" />
                </StackPanel>
            </Grid>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Style="{StaticResource LetraTextBox}" Padding="16,8" Margin="8,0"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Letra, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Resources>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <Button Grid.Row="1" Content="Guardar" Margin="0,4,16,16"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ActionConfirmButton}"
                    Command="{Binding SalvarCommand}" />
        </Grid>
    </Grid>
</Window>