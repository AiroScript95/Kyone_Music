<Window x:Class="KyoneMusic.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        xmlns:vm="clr-namespace:KyoneMusic.ViewModels"
        xmlns:views="clr-namespace:KyoneMusic.Views"
        xmlns:converters="clr-namespace:KyoneMusic.Converters"
        xmlns:viewmodels="clr-namespace:KyoneMusic.ViewModels"
        xmlns:ctzex="urn:controlzex"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="Kyone Music"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        Focusable="True"
        FontFamily="{DynamicResource FonteUI}"
        Width="1200" Height="700" MinWidth="1000" MinHeight="680">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoadingViewModel}">
            <views:LoadingScreem />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShellViewModel}">
            <views:ShellView />
        </DataTemplate>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" UseAeroCaptionButtons="False" GlassFrameThickness="-1" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel x:Name="RootPanel" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Margin="0" Height="46" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*" />
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="25*" />
                </Grid.ColumnDefinitions>

                <!-- タイトル文字列（WindowChromeがnullのときも出たまま） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0">
                    <!--<Rectangle Width="52" Height="35" Fill="{DynamicResource TextMutedBrush}" />-->
                </StackPanel>

                <!-- トグルボタン（必要に応じて表示/非表示を切り替え可能） -->

                <Grid x:Name="PesquisaRoot" Grid.Column="1" Width="Auto"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.MostrarLetra}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <TextBox x:Name="SearBar" Style="{StaticResource PesquisaTextBox}"
                             Width="360" Height="34" Grid.Column="1"
                             Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12"
                             WindowChrome.IsHitTestVisibleInChrome="True"
                             GotKeyboardFocus="SearBar_GotKeyboardFocus"
                             PreviewKeyDown="SearBar_PreviewKeyDown">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ResultadosEncontradosCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Popup PlacementTarget="{Binding ElementName=SearBar}"
                           Placement="Bottom" StaysOpen="True" Focusable="True"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Popup.Resources>
                            <Style x:Key="SecaoPesquisa" TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="CabecalhoPesquisa" TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Margin" Value="12,10,12,4" />
                            </Style>

                            <!-- botão sem o visual do Windows: só o fundo arredondado + hover -->
                            <Style x:Key="LinhaPesquisa" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Margin="0" Padding="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Musicas -->
                            <DataTemplate x:Key="ResultadoPesquisaTemplate">
                                <Border Background="Transparent" Padding="8,6" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.TocarResultadoCommand, ElementName=PesquisaRoot}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46" Height="46" CornerRadius="4"
                                                Style="{StaticResource BorderClip}"
                                                Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=120}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="UniformToFill" />

                                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesFill" Width="18" Height="18"
                                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                 Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artista}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                                Padding="6" Cursor="Hand"
                                                Tag="{Binding DataContext.Player, ElementName=PesquisaRoot}"
                                                ContextMenu="{StaticResource MusicaContextMenu}"
                                                ContextMenuOpening="TresPontos_ContextMenuOpening"
                                                Click="TresPontos_Click">
                                            <iconPacks:PackIconPhosphorIcons Kind="DotsThreeVerticalBold"
                                                                             Width="14" Height="14"
                                                                             Foreground="{DynamicResource TextMutedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- Artistas e Álbuns -->
                            <DataTemplate x:Key="GrupoArtistaResultadoTemplate">
                                <Button Style="{StaticResource LinhaPesquisa}"
                                        Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46" Height="46" CornerRadius="4" ClipToBounds="True"
                                                Style="{StaticResource BorderCircularClip}"
                                                Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=120}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="UniformToFill" />
                                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesFill" Width="18" Height="18"
                                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                 Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock  Text="{Binding Nome}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4" />
                                            <Border Background="{DynamicResource SurfaceRaisedBrush}" HorizontalAlignment="Left" Padding="4,1" CornerRadius="8">
                                                <TextBlock Text="{DynamicResource Str_Artistas}" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>

                            <DataTemplate x:Key="GrupoAlbumResultadoTemplate">
                                <Button Style="{StaticResource LinhaPesquisa}"
                                        Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46" Height="46" CornerRadius="4" ClipToBounds="True"
                                                Style="{StaticResource BorderClip}"
                                                Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=120}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="UniformToFill" />
                                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesFill" Width="18" Height="18"
                                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                 Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock  Text="{Binding Nome}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4" />
                                            <Border Background="{DynamicResource SurfaceRaisedBrush}" HorizontalAlignment="Left" Padding="4,1" CornerRadius="8">
                                                <TextBlock Text="{DynamicResource Str_Album}" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>

                            <!-- Playlists: sem capa nem contagem -->
                            <DataTemplate x:Key="PlaylistResultadoTemplate">
                                <Button Style="{StaticResource LinhaPesquisa}"
                                        Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46" Height="46" CornerRadius="4" Style="{StaticResource BorderClip}"
                                                Background="{DynamicResource SurfaceAltBrush}">

                                            <iconPacks:PackIconPhosphorIcons Kind="PlaylistBold" Width="18" Height="18"
                                                                             Foreground="{DynamicResource TextMutedBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Name}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="Favoritos">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Background="{DynamicResource SurfaceRaisedBrush}" HorizontalAlignment="Left" Padding="4,1" CornerRadius="8">
                                                <TextBlock Text="{DynamicResource Str_Playlists}" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </Popup.Resources>

                        <Popup.Style>
                            <Style TargetType="Popup">
                                <!--<Setter Property="IsOpen" Value="{Binding PesquisaAberta, Mode=OneWay}" />-->
                                <Setter Property="IsOpen" Value="True" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ResultadosMusica.Count}" Value="0" />
                                            <Condition Binding="{Binding ResultadosArtistas.Count}" Value="0" />
                                            <Condition Binding="{Binding ResultadosAlbuns.Count}" Value="0" />
                                            <Condition Binding="{Binding ResultadosPlaylists.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter  Property="IsOpen" Value="False" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Popup.Style>
                        <Grid  Width="{Binding ActualWidth, ElementName=SearBar}">
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">

                                <StackPanel Margin="4">
                                    <StackPanel Style="{StaticResource SecaoPesquisa}" Tag="{Binding ResultadosMusica.Count}">
                                        <ItemsControl ItemsSource="{Binding ResultadosMusica}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="Linha" CornerRadius="4" Margin="0" Background="Transparent" Style="{StaticResource BorderClip}">
                                                        <ContentPresenter Content="{Binding}"
                                                                          ContentTemplate="{StaticResource ResultadoPesquisaTemplate}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="Linha" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Linha" Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource SecaoPesquisa}" Tag="{Binding ResultadosArtistas.Count}">
                                        <ItemsControl ItemsSource="{Binding ResultadosArtistas}"
                                                      Tag="{Binding AbrirArtistaCommand}"
                                                      ItemTemplate="{StaticResource GrupoArtistaResultadoTemplate}" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource SecaoPesquisa}" Tag="{Binding ResultadosAlbuns.Count}">
                                        <ItemsControl ItemsSource="{Binding ResultadosAlbuns}"
                                                      Tag="{Binding AbrirAlbumCommand}"
                                                      ItemTemplate="{StaticResource GrupoAlbumResultadoTemplate}" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource SecaoPesquisa}" Tag="{Binding ResultadosPlaylists.Count}">
                                        <ItemsControl ItemsSource="{Binding ResultadosPlaylists}"
                                                      Tag="{Binding AbrirPlaylistCommand}"
                                                      ItemTemplate="{StaticResource PlaylistResultadoTemplate}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>

                <!-- コントロールボックス（★ UseCustomTitleBar が False のときは非表示にする） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                            HorizontalAlignment="Right" Margin="0" Background="Transparent">

                    <!-- 最小化 -->
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WinCaptionStyle}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE921;"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Minimize_Click"
                            ToolTip="最小化" />

                    <!-- 最大化 -->
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WinCaptionStyle}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE922;"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Maximize_Click"
                            ToolTip="最大化" />

                    <!-- 閉じる -->
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WinCaptionStyle}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click"
                            ToolTip="閉じる" />
                </StackPanel>
            </Grid>
        </DockPanel>
        <!-- ===== CONTEÚDO (Loading / Shell) ===== -->
        <Grid Grid.Row="1" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}"
              PreviewMouseDown="Window_PreviewMouseDown">
            <!--===== PAGINAS =====-->
            <ContentControl Content="{Binding CurrentView}" ClipToBounds="True" />
        </Grid>
    </Grid>
</Window>