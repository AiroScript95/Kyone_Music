<UserControl x:Class="KyoneMusic.Views.Controls.PlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:KyoneMusic.Views.Controls"
             xmlns:viewmodels="clr-namespace:KyoneMusic.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:PlayerViewModel}"
             DataContext="{Binding PlayerViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,1,0" />
        <Grid MaxHeight="740" Margin="16" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="55*" MinHeight="320" />
                <RowDefinition Height="12*" />
                <RowDefinition Height="8*" />
                <RowDefinition Height="15*" MinHeight="80" />
                <RowDefinition Height="10*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
            </Grid.ColumnDefinitions>

            <!-- Capa grande: música que está a tocar agora -->
            <Border MinWidth="360"
                    MinHeight="320"
                    MaxHeight="380"
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    ClipToBounds="True"
                    CornerRadius="8"
                    Style="{StaticResource BorderClip}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Grid ClipToBounds="True" x:Name="RootGrid">
                    <Image Source="{Binding MusicaAtual.Image, Converter={StaticResource BytesParaImagemConverter}}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <Button x:Name="OverlayMiniPlayer" AutomationProperties.Name=""
                            HorizontalAlignment="Right" Click="AbrirMiniPlayer_Click"
                            VerticalAlignment="Top" Foreground="{DynamicResource AccentAltBrush}" Margin="10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootGrid}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <iconPacks:PackIconPhosphorIcons Kind="PictureInPictureBold" Width="20" />
                    </Button>
                </Grid>
            </Border>
            <!-- Título / Artista da música atual -->
            <Grid Grid.Row="1"  Margin="0,8,0,4">
                <StackPanel VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding MusicaAtual.Titulo, FallbackValue={StaticResource Str_NenhumaMusica}}"
                                   FontSize="22"
                                   MaxWidth="260"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Left" />

                        <StackPanel Orientation="Horizontal"  VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding AlternarGostoCommand}" AutomationProperties.Name=""
                                    CommandParameter="{Binding MusicaAtual}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextError}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding GostoAtual}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <iconPacks:PackIconPhosphorIcons Width="24"
                                                                 Height="18">
                                    <iconPacks:PackIconPhosphorIcons.Style>
                                        <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                            <Setter Property="Kind" Value="HeartBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GostoAtual}"
                                                             Value="True">
                                                    <Setter Property="Kind" Value="HeartFill" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconPhosphorIcons.Style>
                                </iconPacks:PackIconPhosphorIcons>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MusicaAtual.Artista}"
                               FontSize="14"
                               MaxWidth="260"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FonteUIMedium}"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Left" />
                </StackPanel>
            </Grid>
            <!-- Barra de progresso + tempos -->
            <StackPanel Grid.Row="2">
                <Slider Style="{StaticResource PrettySlider}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="{Binding DuracaoTotalMs}"
                        Value="{Binding PosicaoAtualMs}"
                        PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="Slider_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="Slider_PreviewMouseUp"
                        PreviewMouseUp="Slider_PreviewMouseUp"
                        Cursor="Hand" />

                <Grid VerticalAlignment="Center" Margin="0,4">
                    <TextBlock Text="{Binding TempoAtualFormatado, FallbackValue='00:00'}"
                               FontSize="12" Typography.NumeralAlignment="Tabular"
                               FontFamily="{DynamicResource FonteUIMedium}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding TempoTotalFormatado, FallbackValue='00:00'}"
                               FontSize="12" Typography.NumeralAlignment="Tabular"
                               FontFamily="{DynamicResource FonteUIMedium}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
            <!-- Controlos -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Grid.Row="3" Margin="0,0,0,0">

                <Button Command="{Binding AnteriorCommand}" AutomationProperties.Name="{DynamicResource Str_Anterior}"
                        ToolTip="{DynamicResource Str_Anterior}"
                        Style="{StaticResource PlayerControlButton}"
                        Margin="8,0" Padding="12">
                    <Viewbox Width="auto" Height="auto" MaxHeight="54" MaxWidth="54">
                        <iconPacks:PackIconPhosphorIcons Kind="RewindFill" />
                    </Viewbox>
                </Button>

                <Button Command="{Binding AlternarPlayPauseCommand}"
                        Margin="0,0" Padding="12">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlayerPlayButton}">
                            <Setter Property="ToolTip" Value="{DynamicResource Str_Reproduzir}" />
                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str_Reproduzir}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstaTocando}" Value="true">
                                    <Setter Property="ToolTip" Value="{DynamicResource Str_Pausar}" />
                                    <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str_Pausar}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="auto" Height="auto" MaxHeight="48" MaxWidth="48">
                        <iconPacks:PackIconPhosphorIcons>
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Kind"
                                            Value="PlayFill" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstaTocando}"
                                                     Value="True">
                                            <Setter Property="Kind"
                                                    Value="PauseFill" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>
                    </Viewbox>
                </Button>

                <Button Command="{Binding ProximaCommand}"
                        Style="{StaticResource PlayerControlButton}"
                        ToolTip="{DynamicResource Str_Seguinte}"
                        AutomationProperties.Name="{DynamicResource Str_Seguinte}"
                        Margin="8,0" Padding="12">
                    <Viewbox Width="auto" Height="auto" MaxHeight="54" MaxWidth="54">
                        <iconPacks:PackIconPhosphorIcons Kind="FastForwardFill" />
                    </Viewbox>
                </Button>
            </StackPanel>

            <!-- Equalizador / Letras / Repetição -->
            <Grid Grid.Row="4" MaxWidth="320"
                  Margin="0,8,0,0">

                <!-- Botão Equalizador -->
                <Button Command="{Binding AlternarEqualizadorCommand}"
                        Style="{StaticResource IconButtonSmall}"
                        ToolTip="{DynamicResource Str_Equalizador}"
                        AutomationProperties.Name="{DynamicResource Str_Equalizador}"
                        HorizontalAlignment="Left"
                        Margin="4,0">
                    <iconPacks:PackIconPhosphorIcons Kind="SlidersHorizontalBold"
                                                     Width="18" Foreground="{DynamicResource TextSecondaryBrush}"
                                                     Height="18" />
                </Button>

                <!--Botao Mostrar letra -->
                <Button Command="{Binding AlternarLetrasCommand}"
                        Padding="16,8"
                        Height="34"
                        AutomationProperties.Name="{DynamicResource Str_Letras}"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        hc:BorderElement.CornerRadius="16">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
                            <Setter Property="Width" Value="120" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TemLetra}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="180"
                                                                 Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="120"
                                                                 Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseIn" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconPhosphorIcons Kind="ChatCircleDotsBold"
                                                         Width="16"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"
                                                         Visibility="{Binding TemLetra,Converter={StaticResource Boolean2VisibilityReConverter}}" />
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   FontFamily="{DynamicResource FonteUIMedium}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Str_Sem_Letra}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemLetra}" Value="true">
                                            <Setter Property="Text" Value="{Binding LinhaAtual.Texto}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Botão Loop (Todos / Uma) -->
                <Button Command="{Binding AlternarRepeticaoCommand}"
                        HorizontalAlignment="Right"
                        Margin="4,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Repeticao}" Value="RepetirLista">
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Repeticao}" Value="RepetirUma">
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Repeticao}" Value="Aleatorio">
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <iconPacks:PackIconPhosphorIcons Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Kind" Value="RepeatBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Repeticao}" Value="RepetirLista">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Repeticao}" Value="RepetirUma">
                                            <Setter Property="Kind" Value="RepeatOnceBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Repeticao}" Value="Aleatorio">
                                            <Setter Property="Kind" Value="ShuffleBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
        <Grid>
            <Border Style="{StaticResource ConfigCard}" VerticalAlignment="Bottom" Height="0" CornerRadius="16,16,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Button ToolTip="{DynamicResource Str_Fechar}" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Center" Height="auto" Padding="16,8" Width="auto">
                            <Border Width="40" Height="4" Background="{DynamicResource TextMutedBrush}"
                                    Style="{StaticResource BorderCircular}" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <WrapPanel VerticalAlignment="Top" Margin="8">
                            <Button Style="{StaticResource ActionButton}"
                                    Command="{Binding MostrarFilaReproducaoCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconPhosphorIcons Kind="ListBold" />
                                    <TextBlock Text="{DynamicResource Str_FilaReproducao}"
                                               Margin="16,0" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>