<UserControl x:Class="KyoneMusic.Views.Controls.BarrasEqualizador"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Barra" TargetType="Border" BasedOn="{StaticResource BorderCircularClip}">
            <Setter Property="Margin" Value="1,0" />
            <!--<Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />-->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <!--<Setter Property="Fill" Value="{DynamicResource AccentBrush}" />-->
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
    </UserControl.Resources>

    <UniformGrid Rows="1">
        <Border Style="{StaticResource Barra}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Escala1" ScaleY="0.3" />
            </Border.RenderTransform>
        </Border>
        <Border Style="{StaticResource Barra}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Escala2" ScaleY="0.3" />
            </Border.RenderTransform>
        </Border>
        <Border Style="{StaticResource Barra}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Escala3" ScaleY="0.3" />
            </Border.RenderTransform>
        </Border>
        <Border Style="{StaticResource Barra}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Escala4" ScaleY="0.3" />
            </Border.RenderTransform>
        </Border>
        <Border Style="{StaticResource Barra}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Escala5" ScaleY="0.3" />
            </Border.RenderTransform>
        </Border>
    </UniformGrid>
</UserControl>