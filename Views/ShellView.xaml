<UserControl x:Class="KyoneMusic.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:KyoneMusic.Converters"
             xmlns:vm="clr-namespace:KyoneMusic.ViewModels.ShellPages"
             xmlns:vms="clr-namespace:KyoneMusic.ViewModels.ShellPages.SearchPages"
             xmlns:pages="clr-namespace:KyoneMusic.Views.ShellPages"
             xmlns:psch="clr-namespace:KyoneMusic.Views.ShellPages.SearchPages"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:viewmodels="clr-namespace:KyoneMusic.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ShellViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:MusicListPageViewModel}">
            <pages:MusicListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfiguracoesPageViewModel}">
            <pages:ConfiguracoesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigThemePageViewModel}">
            <pages:ConfigThemePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistsPageViewModel}">
            <pages:PlaylistsPages />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistDetailPageViewModel}">
            <pages:PlaylistDetailPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArtistasPageViewModel}">
            <pages:ArtistasPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlbunsPageViewModel}">
            <pages:AlbunsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GrupoDetailPageViewModel}">
            <pages:GrupoDetailPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchResultPageViewModel}">
            <pages:SearchResultPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:SearchMusicPageViewModel}">
            <psch:SearchMusicPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:SearchAlbumPageViewModel}">
            <psch:SearchAlbumPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:SearchArtistaPageViewModel}">
            <psch:SearchArtistaPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:SearchPlaylistViewPageModel}">
            <psch:SearchPlaylistPage />
        </DataTemplate>

        <DataTemplate x:Key="ListaMusicaTemplate">
            <Border CornerRadius="8" Style="{DynamicResource BorderClip}" BorderThickness="1" Cursor="SizeAll">
                <Grid>
                    <Grid Opacity="0.65">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.Player.MusicaAtual"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="60"
                                Height="60"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}"
                                ClipToBounds="True">
                            <Grid ClipToBounds="True" x:Name="Image" Cursor="Hand">
                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=120}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesFill"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                <Grid MouseLeftButtonUp="Music_MouseLeftButtonUp" Background="Transparent">
                                    <iconPacks:PackIconPhosphorIcons Kind="PlayFill" Foreground="{DynamicResource ButtonIconBrush}" Width="30" Height="30"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Image}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="left"
                                    Margin="12,0"
                                    Background="Transparent">
                            <TextBlock Text="{Binding Titulo}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.Player.MusicaAtual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4">
                                <TextBlock Text="{Binding Artista}"
                                           FontSize="12"
                                           MaxWidth="150"
                                           VerticalAlignment="Center"

                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="•"
                                           Margin="4,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Album}"

                                           FontSize="12"
                                           MaxWidth="150"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderThickness="0"
                                        Visibility="{Binding TemLetraDisponivel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        CornerRadius="5"
                                        Margin="0,0,6,0"
                                        BorderBrush="{DynamicResource SecondaryBorderBrush}">
                                    <TextBlock Text="{DynamicResource Str_Letras}"

                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="6,0" />
                                </Border>
                                <TextBlock Text="{Binding DuracaoArredondada}"

                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <iconPacks:PackIconPhosphorIcons Grid.Column="2" Margin="10,0" Width="14" Height="18" Kind="ListThin" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="LinhaSincronizada">
            <TextBlock Text="{Binding Texto}"
                       TextWrapping="Wrap" Padding="0,12" Background="Transparent" Cursor="Hand"
                       MouseLeftButtonUp="LinhaLetra_Click" TextAlignment="Left">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Opacity" Value="0.5" />
                        <Setter Property="FontSize" Value="30" />
                        <Style.Triggers>

                            <!-- Controlos ocultos: maior -->
                            <DataTrigger Binding="{Binding DataContext.Player.OcultarControles, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="FontSize" Value="36" />
                            </DataTrigger>

                            <!-- Hover numa linha que não é a atual -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Mode=Self}}" Value="True" />
                                    <Condition Value="False">
                                        <Condition.Binding>
                                            <MultiBinding Converter="{StaticResource LinhaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.Player.LinhaAtual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </Condition.Binding>
                                    </Condition>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.25" FillBehavior="Stop">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>

                            <!-- Linha atual: Bold, branca e opaca -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource LinhaAtualConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.Player.LinhaAtual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.25" FillBehavior="Stop">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="LinhaNaoSincronizada">
            <TextBlock Text="{Binding Texto}"
                       TextWrapping="Wrap" Margin="0,12" TextAlignment="Left"
                       HorizontalAlignment="Left" FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="22" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Player.OcultarControles, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="FontSize" Value="26" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <!--Conteudo UserControl-->
        <Grid ClipToBounds="True" Focusable="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Player.MostrarLetra}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  SIDEBAR  -->
            <Grid Margin="0,10" Grid.Column="0" Grid.Row="1">
                <StackPanel VerticalAlignment="Center"  HorizontalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                            <Setter Property="Margin" Value="0,8,0,0" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Command="{Binding IrParaMusicasCommand}"
                            ToolTip="{DynamicResource Str_Musicas}">
                        <iconPacks:PackIconPhosphorIcons Width="20" Height="20">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Kind" Value="MusicNotesBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="MusicList">
                                            <Setter Property="Kind" Value="MusicNotesFill" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>
                    </Button>
                    <Button Command="{Binding IrParaPlaylistCommand}"
                            ToolTip="{DynamicResource Str_Playlists}">
                        <iconPacks:PackIconPhosphorIcons Width="20" Height="20">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Kind" Value="PlaylistBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="Playlist">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>
                    </Button>
                    <Button Command="{Binding AbrirFavoritosCommand}"
                            ToolTip="{DynamicResource Str_Add_Play}">
                        <iconPacks:PackIconPhosphorIcons Width="20" Height="20">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Kind" Value="HeartBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="Favoritos">
                                            <Setter Property="Kind" Value="HeartFill" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>
                    </Button>
                    <Button Command="{Binding IrParaArtistasCommand}"
                            ToolTip="{DynamicResource Str_Artistas}"
                            VerticalAlignment="Top" HorizontalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons Width="20" Height="20">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Kind" Value="MicrophoneBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="Artistas">
                                            <Setter Property="Kind" Value="MicrophoneFill" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>
                    </Button>
                    <Button Command="{Binding IrParaAlbunsCommand}"
                            ToolTip="{DynamicResource Str_Albuns}"
                            VerticalAlignment="Top" HorizontalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons Width="20" Height="20">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Kind" Value="VinylRecordBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="Albuns">
                                            <Setter Property="Kind" Value="VinylRecordFill" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>
                    </Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,8">
                    <Button Command="{Binding IrParaConfiguracoesCommand}"
                            Style="{StaticResource SidebarButton}"
                            ToolTip="{DynamicResource Str_Configuracoes}"
                            VerticalAlignment="Top" HorizontalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons Width="20" Height="20">
                            <iconPacks:PackIconPhosphorIcons.Style>
                                <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                    <Setter Property="Kind" Value="GearSixBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="Config">
                                            <Setter Property="Kind" Value="GearSixFill" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconPhosphorIcons.Style>
                        </iconPacks:PackIconPhosphorIcons>
                    </Button>
                </StackPanel>
            </Grid>
            <!--  CONTEÚDO  -->
            <Border Grid.Column="1" Grid.Row="1" Style="{DynamicResource BorderClip}" CornerRadius="16,0,0,0"  ClipToBounds="True">
                <Grid>
                    <Grid ClipToBounds="True">
                        <!--<svg:SvgViewbox Source="{Binding Tema,Converter={StaticResource StringToUriConverter}}"
                        Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" />-->
                        <Image Source="{Binding CaminhoBackground, Converter={StaticResource StringParaImagemConverter}}"
                               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding MostrarImage,Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Grid ClipToBounds="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="0.8" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostrarImage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <ContentControl  Content="{Binding CurrentPage}" ClipToBounds="True">
                        <ContentControl.Resources>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1"
                                                                 Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="30" To="0"
                                                                 Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="0" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!--Modal Excluir-->
        <Grid Visibility="{Binding Player.MostrarConfirmacaoExclusao, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="11">
            <Grid Background="{DynamicResource SurfaceBrush}" Opacity="0.6">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding Player.CancelarExclusaoCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Grid>
            <Border Width="320" Height="180" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ConfigCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Player.MostrarConfirmacaoExclusao}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Viewbox Width="40" Margin="0,8" Grid.Row="0">
                        <iconPacks:PackIconPhosphorIcons Kind="TrashSimpleFill"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource TextError}" />
                    </Viewbox>
                    <TextBlock Text="{DynamicResource Str_ConfirmarEliminarMusica}" Grid.Row="1"
                               TextWrapping="Wrap" Width="260"
                               FontSize="14" TextAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid Grid.Row="2" Margin="8">
                        <Button Content="{DynamicResource Str_Cancelar}" Command="{Binding Player.CancelarExclusaoCommand}"
                                Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button Command="{Binding Player.ConfirmarExclusaoCommand}"
                                Content="{DynamicResource Str_Eliminar}"
                                Style="{StaticResource ActionDeletButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== MODAL: NOVA PLAYLIST ===== -->
        <Grid Visibility="{Binding MostrarModalCriarPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource SurfaceOverlayBrush}" Opacity="0.25">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding FecharModalCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Border>
            <Border Width="340"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ConfigCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarModalCriarPlaylist}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Str_Nome_Play}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"

                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button Command="{Binding FecharModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButtonSmall}">
                            <iconPacks:PackIconPhosphorIcons Kind="X" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <TextBox Text="{Binding NovaPlaylist, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxExtend}"
                             Height="Auto"
                             Margin="0,8"
                             BorderThickness="0"
                             BorderBrush="{DynamicResource BorderBrush2}"
                             Background="{DynamicResource SurfaceRaisedBrush}"
                             FontSize="12"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Padding="16,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,60,0,0">
                        <Button Content="{DynamicResource Str_Cancelar}" Command="{Binding FecharModalCommand}" Margin="0,0,8,0"
                                Style="{StaticResource ActionButton}" />
                        <Button Content="{DynamicResource Str_Criar}" Command="{Binding CriarPlaylistCommand}"
                                Style="{StaticResource ActionConfirmButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== MODAL: CONFIRMAR EXCLUSÃO Playlist ===== -->
        <Grid Visibility="{Binding MostrarConfirmacaoExclusaoPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource SurfaceOverlayBrush}" Opacity="0.25">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding CancelarExclusaoPlaylistCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Border>
            <Border Padding="8"
                    Width="300"
                    Height="180"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ConfigCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarConfirmacaoExclusaoPlaylist}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Viewbox Width="40"  Grid.Row="0">
                        <iconPacks:PackIconPhosphorIcons Kind="TrashSimpleFill"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextError}" />
                    </Viewbox>

                    <TextBlock Text="{Binding PlayListParaExcluir}"
                               TextWrapping="Wrap"  Grid.Row="1"
                               FontSize="14"   Width="260"
                               TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Grid Margin="0,0,0,0" VerticalAlignment="Bottom"  Grid.Row="2">

                        <Button Content="{DynamicResource Str_Cancelar}"
                                Command="{Binding CancelarExclusaoPlaylistCommand}"
                                Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left" />

                        <Button Content="{DynamicResource Str_Eliminar}"
                                Command="{Binding ConfirmarExclusaoPlaylistCommand}"
                                Style="{StaticResource ActionDeletButton}"
                                HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- LETRAS -->
        <Grid Background="{DynamicResource SurfaceBrush}" Focusable="True" Panel.ZIndex="10">
            <Grid.RenderTransform>
                <TranslateTransform Y="100" />
            </Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Player.MostrarLetra}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="100" To="0" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="0" To="100" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.10" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Botão fechar -->
            <Grid Grid.Row="0" Height="auto">
                <Button ToolTip="{DynamicResource Str_Fechar}" Style="{StaticResource IconButton}"
                        HorizontalAlignment="Center" Height="auto" Padding="16,8" Width="auto"
                        Command="{Binding Player.FecharLetraCommand}">
                    <Border Width="40" Height="4" Background="{DynamicResource TextMutedBrush}" Style="{StaticResource BorderCircular}" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  COLUNA 0: Player  -->
                <Grid Grid.Column="0" Margin="10,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Width" Value="400" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.OcultarControles}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.20">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="400" Duration="0:0:0.20">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid HorizontalAlignment="Center"  VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*" />
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="12*" />
                            <RowDefinition Height="15*" />
                        </Grid.RowDefinitions>

                        <!-- Capa grande -->
                        <Border Grid.Row="0" MaxHeight="360" MaxWidth="360"
                                Background="{DynamicResource SurfaceBrush}"
                                ClipToBounds="True"
                                CornerRadius="16"
                                Style="{StaticResource BorderClip}"
                                HorizontalAlignment="Center" VerticalAlignment="Top">

                            <Grid ClipToBounds="True" x:Name="RootGrid">
                                <Image Source="{Binding Player.MusicaAtual.Image, Converter={StaticResource BytesParaImagemConverter}}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <iconPacks:PackIconPhosphorIcons Kind="MusicNotesFill"
                                                                 Width="48" Height="48"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="{Binding Player.MusicaAtual.Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                <Button x:Name="OverlayMiniPlayer"
                                        HorizontalAlignment="Right" Click="AbrirMiniPlayer_Click"
                                        VerticalAlignment="Top" Foreground="{DynamicResource TextOnAccentBrush}" Margin="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootGrid}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconPhosphorIcons Kind="PictureInPicture" Width="20" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Título / Artista -->
                        <Grid Grid.Row="1">
                            <StackPanel Margin="0,16,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding Player.MusicaAtual.Titulo, FallbackValue='Nenhuma música'}"
                                               FontSize="22"
                                               MaxWidth="260"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Left" />

                                    <StackPanel Orientation="Horizontal"  VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <Button Command="{Binding Player.AlternarGostoCommand}"
                                                CommandParameter="{Binding Player.MusicaAtual}"
                                                Style="{StaticResource IconButtonSmall}"
                                                Width="32"
                                                Height="32"
                                                Margin="4,0">
                                            <iconPacks:PackIconPhosphorIcons Width="24"
                                                                             Height="18">
                                                <iconPacks:PackIconPhosphorIcons.Style>
                                                    <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                                        <Setter Property="Kind"
                                                                Value="HeartBold" />
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Player.GostoAtual}"  Value="True">
                                                                <Setter Property="Kind" Value="HeartFill" />
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextError}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconPhosphorIcons.Style>
                                            </iconPacks:PackIconPhosphorIcons>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Player.MusicaAtual.Artista}"
                                           FontSize="14"
                                           MaxWidth="260"
                                           HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Left"
                                           Margin="0,0,0,20" />
                            </StackPanel>
                        </Grid>

                        <!-- Progresso -->
                        <StackPanel Grid.Row="2">
                            <Slider  Style="{StaticResource PrettySlider}" HorizontalAlignment="Stretch"
                                    Minimum="0" Maximum="{Binding Player.DuracaoTotalMs}"
                                    Value="{Binding Player.PosicaoAtualMs}"
                                    PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Slider_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="Slider_PreviewMouseUp"
                                    PreviewMouseUp="Slider_PreviewMouseUp"
                                    Cursor="Hand" />

                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="{Binding Player.TempoAtualFormatado, FallbackValue='0:00'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Player.TempoTotalFormatado, FallbackValue='0:00'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Controlos principais -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Grid.Row="3" Margin="0,0">

                            <Button Command="{Binding Player.AnteriorCommand}"
                                    Style="{StaticResource PlayerControlButton}"
                                    Margin="8,0" Padding="12">
                                <Viewbox Width="auto" Height="auto" MaxHeight="46" MaxWidth="46">
                                    <iconPacks:PackIconPhosphorIcons Kind="RewindFill" />
                                </Viewbox>
                            </Button>

                            <Button Command="{Binding Player.AlternarPlayPauseCommand}"
                                    Style="{StaticResource PlayerPlayButton}"
                                    Margin="0,0" Padding="12">
                                <Viewbox Width="auto" Height="auto" MaxHeight="44" MaxWidth="44">
                                    <iconPacks:PackIconPhosphorIcons>
                                        <iconPacks:PackIconPhosphorIcons.Style>
                                            <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                                <Setter Property="Kind" Value="PlayFill" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Player.EstaTocando}" Value="True">
                                                        <Setter Property="Kind" Value="PauseFill" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </iconPacks:PackIconPhosphorIcons.Style>
                                    </iconPacks:PackIconPhosphorIcons>
                                </Viewbox>
                            </Button>

                            <Button Command="{Binding Player.ProximaCommand}"
                                    Style="{StaticResource PlayerControlButton}"
                                    Margin="8,0" Padding="12">
                                <Viewbox Width="auto" Height="auto" MaxHeight="46" MaxWidth="46">
                                    <iconPacks:PackIconPhosphorIcons Kind="FastForwardFill" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!--  COLUNA 1: Letras  -->
                <Grid Grid.Column="1" Margin="0,8,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,0,0,8">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_Letras}" Foreground="{DynamicResource TextMutedBrush}"
                                       Style="{StaticResource TitleMain}" Margin="0" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Command="{Binding Player.AlternarControlesCommand}" Margin="6,0"
                                    ToolTip="{DynamicResource Str_Ocultar_controles}"
                                    Style="{StaticResource IconButtonSmall}">
                                <iconPacks:PackIconPhosphorIcons>
                                    <iconPacks:PackIconPhosphorIcons.Style>
                                        <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                            <Setter Property="Kind" Value="TextOutdentBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.Player.OcultarControles, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="true">
                                                    <Setter Property="Kind" Value="TextIndentBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconPhosphorIcons.Style>
                                </iconPacks:PackIconPhosphorIcons>
                            </Button>
                            <Button ToolTip="{DynamicResource Str_Rolagem}" Style="{StaticResource IconButtonSmall}"
                                    Command="{Binding Player.AlternarScrollAutomaticoCommand}" Margin="6,0">
                                <iconPacks:PackIconPhosphorIcons Kind="ArrowDownBold">
                                    <iconPacks:PackIconPhosphorIcons.Style>
                                        <Style TargetType="iconPacks:PackIconPhosphorIcons">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Player.ScrollAutomaticoAtivo}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconPhosphorIcons.Style>
                                </iconPacks:PackIconPhosphorIcons>
                            </Button>
                            <Button ToolTip="{DynamicResource Str_Editar}" Style="{StaticResource IconButtonSmall}"
                                    Click="EditarLetra_Click">
                                <iconPacks:PackIconPhosphorIcons Kind="EraserBold" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Player.TemLetra, Converter={StaticResource Boolean2VisibilityReConverter}}">

                            <StackPanel>
                                <iconPacks:PackIconPhosphorIcons Kind="ListMagnifyingGlass" Width="80" Height="80"
                                                                 HorizontalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}" />
                                <TextBlock Text="{DynamicResource Str_Sem_Letra}"  HorizontalAlignment="Center" FontSize="14"
                                           Foreground="{DynamicResource TextDisabledBrush}" FontFamily="{DynamicResource FonteUISemiBold}" />
                            </StackPanel>
                            <Button Style="{StaticResource ActionButton}"  Margin="0,10,0,0"
                                    Click="EditarLetra_Click" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconPhosphorIcons Kind="PlusBold" Width="14" Height="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Str_Add_Letra}" FontSize="14" Margin="10,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ScrollViewer x:Name="ScrollLetras"
                                      PreviewMouseWheel="ScrollLetras_PreviewMouseWheel"
                                      PreviewMouseDown="ScrollLetras_PreviewMouseDown"
                                      Template="{StaticResource MeuScrollViewer}"
                                      VerticalScrollBarVisibility="Hidden" Margin="26,0,0,22"
                                      Visibility="{Binding Player.TemLetra, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <ItemsControl x:Name="ItemsLetras" ItemsSource="{Binding Player.LetraAtual.Linhas}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="ItemTemplate" Value="{StaticResource LinhaNaoSincronizada}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Player.LetraAtual.Sincronizada}" Value="True">
                                                    <Setter Property="ItemTemplate" Value="{StaticResource LinhaSincronizada}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                                <TextBlock x:Name="TextoFonteLetra"
                                           HorizontalAlignment="Left"
                                           MouseLeftButtonUp="TextoFonteLetra_Click"
                                           VerticalAlignment="Top"
                                           Margin="0,20"
                                           FontSize="16"
                                           FontFamily="{DynamicResource FonteUISemiBold}"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Player.FonteTexto}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Player.FonteTexto}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Player.LetraEditada}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Str_LetraEditada}" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                    <Setter Property="TextDecorations" Value="None" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- EQUALIZADOR -->
        <Grid Background="Transparent" Visibility="{Binding Player.MostrarEqualizador,Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="9">
            <Grid Background="Transparent" Opacity="0.2">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding Player.FecharEqualizadorCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Grid>
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform Y="100" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Player.MostrarEqualizador}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                From="100" To="0" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                From="0" To="100" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.10" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" VerticalAlignment="Center"
                        CornerRadius="8" Width="600" Height="500" Padding="4">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,0">
                            <TextBlock Text="{DynamicResource Str_Equalizador}" Style="{StaticResource ConfigSectionTitle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0" />
                            <Button BorderThickness="0" Command="{Binding Player.FecharEqualizadorCommand}"
                                    Background="Transparent" Width="Auto" Height="40"
                                    Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"
                                    HorizontalAlignment="Center" ToolTip="{DynamicResource Str_Fechar}">
                                <Border Width="50" Height="5" Background="{DynamicResource TextMutedBrush}" Style="{StaticResource BorderCircular}" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <!-- Bandas do Equalizador -->
                            <ItemsControl Grid.Row="0"  ItemsSource="{Binding Player.Bandas}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,0" Width="40">
                                            <TextBlock Text="{Binding Ganho, StringFormat={}{0:+0.#;-0.#;0}dB}"
                                                       HorizontalAlignment="Center" FontSize="10"
                                                       FontWeight="Medium"
                                                       FontFamily="{DynamicResource FonteUIMedium}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid Height="220">
                                                    <Grid.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Width" Value="30" />
                                                            <Setter Property="Height" Value="2" />
                                                            <Setter Property="CornerRadius" Value="2" />
                                                            <Setter Property="Margin" Value="0,4" />
                                                            <Setter Property="Opacity" Value="0.25" />
                                                            <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                        </Style>
                                                    </Grid.Resources>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="10*" />
                                                        <RowDefinition Height="10*" />
                                                        <RowDefinition Height="10*" />
                                                        <RowDefinition Height="10*" />
                                                        <RowDefinition Height="10*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" />
                                                    <Border Grid.Row="1" />
                                                    <Border Grid.Row="2" />
                                                    <Border Grid.Row="3" />
                                                    <Border Grid.Row="4" />
                                                </Grid>
                                                <Slider Minimum="-12" Maximum="12" Background="{DynamicResource SurfaceRaisedBrush}"
                                                        Value="{Binding Ganho, Mode=TwoWay}" Width="40"
                                                        Orientation="Vertical" Height="220"
                                                        Style="{StaticResource PrettySliderEqualizer}"
                                                        HorizontalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Frequencia, StringFormat={}{0}Hz}"
                                                       HorizontalAlignment="Center" FontSize="10"
                                                       FontWeight="Medium"
                                                       FontFamily="{DynamicResource FonteUIMedium}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Presets -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Player.Presets}"
                                     SelectedValuePath="Indice"
                                     SelectedValue="{Binding Player.PresetSelecionadoIndice}"
                                     Background="Transparent" BorderThickness="0"
                                     Margin="8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     HorizontalContentAlignment="Center">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nome}" FontSize="12"  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="Padding" Value="16,8" />
                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"

                                                            CornerRadius="6" MinWidth="80" HorizontalAlignment="Center"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Fila de Reproducao -->
        <Grid Visibility="{Binding Player.MostrarFila,Converter={StaticResource BooleanToVisibilityConverter}}"  Panel.ZIndex="7">
            <Grid Background="{DynamicResource SurfaceOverlayBrush}" Opacity="0.2">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding Player.FecharFilaReproducaoCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Grid>
            <Grid Background="{DynamicResource SurfaceAltBrush}"
                  HorizontalAlignment="Right">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Player.MostrarFila,Converter={StaticResource BooleanToVisibilityConverter}}" Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="500"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="0"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="100*" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="16,8">
                    <TextBlock Text="{DynamicResource Str_FilaReproducao}" HorizontalAlignment="Left"  FontWeight="Medium"
                               VerticalAlignment="Center"  FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Command="{Binding Player.MostrarFilaReproducaoCommand}" Style="{StaticResource IconButtonSmall}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons Kind="TextIndent" />
                    </Button>
                </Grid>
                <ListBox Grid.Row="1"
                         x:Name="Lista"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="Lista_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="Lista_PreviewMouseMove"
                         Drop="Lista_Drop"
                         ClipToBounds="True"
                         ItemsSource="{Binding Player.Fila}"
                         Padding="16,0"
                         ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ItemTemplate="{StaticResource ListaMusicaTemplate}"
                         ScrollViewer.CanContentScroll="True"
                         Style="{x:Null}"
                         Background="Transparent"
                         BorderThickness="0" Margin="0,0,10,0">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                        </Style>
                    </ListBox.Resources>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Avisos -->
        <Grid HorizontalAlignment="Right" Style="{StaticResource TransicaoEntrada}"
              VerticalAlignment="Bottom" Margin="0,0,20,60"
              Visibility="{Binding MostrarAvisoPastas, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding PastasEmFalta}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8,4"
                                Padding="16,8"
                                CornerRadius="0"
                                Background="{DynamicResource SurfaceOverlayBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1"
                                Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform X="20" />
                            </Border.RenderTransform>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1"
                                                                     Duration="0:0:0.25" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     From="20" To="0"
                                                                     Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <iconPacks:PackIconPhosphorIcons Kind="WarningBold" Width="18" Height="18"
                                                                 Foreground="{DynamicResource TextWarning}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}" Margin="10,0,0,0"
                                           Style="{StaticResource TituloSecao}"
                                           FontFamily="{DynamicResource FonteUIMedium}"
                                           FontSize="14"
                                           HorizontalAlignment="Left"
                                           TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           MaxWidth="320"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"  Background="{DynamicResource ButtonSurfaceBrush}"
                    Style="{StaticResource IconButtonSmall}"
                    Command="{Binding FecharAvisoPastasCommand}">
                <iconPacks:PackIconPhosphorIcons Kind="XBold"
                                                 Width="12"
                                                 Height="12" />
            </Button>
        </Grid>
    </Grid>
</UserControl>